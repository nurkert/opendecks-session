// Allow members of plugdev to unmount and power off USB sticks (eject).
polkit.addRule(function (action, subject) {
  if ((action.id.indexOf("org.freedesktop.udisks2.filesystem-unmount") == 0 ||
       action.id.indexOf("org.freedesktop.udisks2.power-off-drive") == 0 ||
       action.id.indexOf("org.freedesktop.udisks2.eject-media") == 0) &&
      subject.isInGroup("plugdev")) {
    return polkit.Result.YES;
  }
});
