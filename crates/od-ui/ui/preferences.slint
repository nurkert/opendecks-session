// Preferences: a separate window (categories on
// the left, the page on the right), drawn in OpenDecks' own language: the
// selected category hangs from the rail by a sodium line, settings are
// rows of bone labels with outlined plates.

import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { Caps, PlateButton, Field, Glyph, TipArea } from "controls.slint";
import { TooltipLayer } from "tooltip.slint";
import { ComboBox } from "std-widgets.slint";

export struct KeyRow {
    // Empty for group headers.
    id: string,
    title: string,
    binding: string,
    // "PREPARE", "PERFORM" or empty (everywhere).
    scope: string,
    custom: bool,
    header: bool,
}

// One category on the left rail.
component Category inherits Rectangle {
    in property <string> label;
    in property <bool> current;
    callback clicked();
    accessible-role: tab;
    accessible-item-selectable: true;
    accessible-item-selected: root.current;
    height: 34px;
    background: touch.has-hover && !root.current ? Theme.ground-band : transparent;
    VLine { x: 12px; y: 7px; height: parent.height - 14px; weight: 2px; tone: root.current ? Theme.attention : transparent; form: "double"; }
    Text {
        x: 28px; height: parent.height;
        text: root.label;
        font-family: Theme.family; font-size: 13px; font-weight: 600; letter-spacing: 2.2px;
        color: root.current ? Theme.bone : Theme.bone-2;
        vertical-alignment: center;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A section heading on a page.
component Heading inherits VerticalLayout {
    in property <string> text;
    in property <string> note;
    padding-top: 14px;
    spacing: 4px;
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.text; font-family: Theme.family; font-size: Theme.rank-c; font-weight: 600; color: Theme.bone; vertical-alignment: center; }
        if root.note != "": Caps { text: root.note; color: Theme.attention; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
    }
    HLine { tone: Theme.rule; }
}

// A labelled setting row.
component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 16px;
    min-height: 32px;
    VerticalLayout {
        width: 190px;
        padding-top: 5px;
        Text {
            text: root.label;
            font-family: Theme.family; font-size: Theme.body; color: Theme.bone-2;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
    }
    @children
}

// One of several values, as outlined plates side by side.
component Choice inherits HorizontalLayout {
    in property <[string]> options;
    in property <int> selected;
    callback picked(int);
    accessible-role: combobox;
    accessible-value: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "";
    spacing: 6px;
    alignment: start;
    for o[i] in root.options: PlateButton {
        compact: true;
        label: o;
        active: i == root.selected;
        tone: i == root.selected ? Theme.attention : Theme.bone-3;
        clicked => { root.picked(i); }
    }
}

// An on / off setting: a line that is solid when on, half when off.
component Switch inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled(bool);
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.on;
    height: 28px;
    min-width: t.preferred-width + 24px;
    VLine { x: 2px; y: 5px; height: parent.height - 10px; weight: 2px; tone: root.on ? Theme.live : Theme.rule-strong; form: root.on ? "solid" : "half"; }
    t := Text {
        x: 16px; height: parent.height;
        text: root.label;
        font-family: Theme.family; font-size: 14px;
        color: root.on ? Theme.bone : Theme.bone-2;
        vertical-alignment: center;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(!root.on); } }
}

// A choice among many (devices): one line per option.
component RadioList inherits VerticalLayout {
    in property <[string]> options;
    in property <int> selected;
    callback picked(int);
    accessible-role: list;
    accessible-value: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "";
    alignment: start;
    for o[i] in root.options: Rectangle {
        height: 26px;
        background: ta.has-hover ? Theme.ground-band : transparent;
        VLine { x: 2px; y: 5px; height: parent.height - 10px; weight: 2px; tone: i == root.selected ? Theme.attention : Theme.rule-strong; form: i == root.selected ? "double" : "half"; }
        Text {
            x: 16px; width: parent.width - 20px; height: parent.height;
            text: o; overflow: elide;
            font-family: Theme.family; font-size: 14px;
            color: i == root.selected ? Theme.bone : Theme.bone-2;
            vertical-alignment: center;
        }
        ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
    }
}

// A compact plate that keeps its size in a row.
component Button inherits VerticalLayout {
    in property <string> label;
    in property <color> tone: Theme.bone-3;
    in property <string> tooltip;
    // Test / screen-reader identifier of the plate (empty: none).
    in property <string> a11y-label;
    callback clicked();
    horizontal-stretch: 0;
    alignment: center;
    PlateButton { accessible-role: button; accessible-label: root.a11y-label; compact: true; label: root.label; tone: root.tone; tooltip: root.tooltip; clicked => { root.clicked(); } }
}

// Plain explanatory text.
component Note inherits Text {
    font-family: Theme.family; font-size: 12px; color: Theme.bone-3;
    wrap: word-wrap;
}

export component PreferencesWindow inherits Window {
    title: @tr("Preferences — OpenDecks Session");
    preferred-width: 900px;
    preferred-height: 680px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.ground;
    default-font-family: Theme.family;
    default-font-size: Theme.body;

    in-out property <string> page: "audio";
    in property <string> platform-note;

    // Audio.
    in property <[string]> audio-devices;
    in property <int> audio-device;
    in property <[string]> buffer-options;
    in property <int> buffer;
    in property <[string]> rate-options;
    in property <int> rate;
    in property <int> headphones;
    in property <string> audio-status;
    in property <bool> audio-pending;

    // View.
    in property <int> language;
    in property <int> notation;
    in property <[string]> scale-options;
    in property <int> scale;
    in property <bool> scale-pending;
    in property <bool> colorblind;
    in property <bool> high-contrast;
    in property <bool> reduced-motion;
    in property <int> appearance;
    // 0 countdown to phrase end, 1 to the next memory cue, 2 count up.
    in property <int> bar-counter;
    in property <int> waveform;
    in property <bool> phrases;
    // Index into the zoom spans (4, 8, 16, 32 s), text sizes (12–18 px)
    // and line spacings (compact, normal, roomy).
    in property <int> zoom-span;
    in property <int> font-size;
    in property <int> line-spacing;

    // Controller > Decks and Mixer (indices into the option lists).
    in property <int> tempo-range;
    in property <bool> deck-quantize;
    in property <int> jog-mode;
    in property <bool> auto-cue;
    in property <int> eq-mode;
    in property <int> fader-curve;
    in property <int> crossfader-curve;
    in property <bool> auto-gain;

    // Analysis.
    in property <[string]> bpm-options;
    in property <int> bpm-range;
    in property <bool> detect-key;
    in property <bool> detect-phrases;
    in property <bool> auto-analyse;

    // Controller.
    in property <[string]> controllers;
    in property <[string]> mappings;
    in property <string> mapping-file;
    // MIDI monitor and learn.
    in property <bool> midi-monitor;
    in property <[string]> midi-lines;
    in property <bool> learn-active;
    in property <[string]> learn-actions;
    in property <int> learn-action;
    in property <int> learn-deck;
    in property <string> learn-result;
    in property <string> learn-entry;
    in property <string> learn-file;
    // DDJ-FLX10 utility settings.
    in property <int> flx10-fader-start;
    in property <int> flx10-rec-out;
    in property <int> flx10-time-mode;
    in property <bool> flx10-slip-flashing;
    in property <int> flx10-slip-led;
    in property <bool> flx10-virtual-deck;
    in property <int> flx10-jog-ring;
    in property <int> flx10-boost;
    in property <string> flx10-wire;
    in property <bool> mapping-pending;

    // Keyboard.
    in property <[KeyRow]> key-rows;
    in-out property <string> key-search;
    in property <string> recording-id;
    in property <string> key-message;
    in property <bool> key-conflict;
    in property <int> key-count;
    // Keyboard navigation of the list: the selected action, the scroll
    // position and the visible height.
    in property <string> key-selected;
    in-out property <length> key-scroll;
    out property <length> key-view-height;

    // Recording.
    in property <int> rec-format;
    in property <string> rec-folder;
    in property <bool> auto-split;
    in property <bool> silence-start;
    in property <bool> silence-stop;
    in property <string> rec-note;
    in property <string> rec-pattern;
    // The file name the pattern gives (example).
    in property <string> rec-example;
    in property <[string]> rec-gain-options;
    in property <int> rec-gain;

    // Advanced.
    in property <string> library-path;
    in property <bool> library-pending;
    in property <string> backups-text;
    in property <bool> backup-on-start;
    in property <bool> update-auto;
    in property <bool> update-prereleases;
    in property <string> update-status;

    callback select-page(string);
    // Choices by key ("audio.device", "view.language", …) and index.
    callback choose(string, int);
    callback flag(string, bool);
    callback act(string);
    // A typed setting by key ("rec.pattern"), on Return.
    callback text(string, string);
    callback search-keys(string);
    callback record-key(string);
    callback reset-key(string);
    callback clear-key(string);
    // Key text and modifiers as in the main window.
    callback key-event(string, bool, bool, bool, bool) -> bool;

    public function focus-keys() { keys.focus(); }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (root.key-event(event.text, event.modifiers.control, event.modifiers.meta, event.modifiers.alt, event.modifiers.shift)) {
                return accept;
            }
            reject
        }

        HorizontalLayout {
            // ── Categories ──
            Rectangle {
                width: 200px;
                VLine { x: Theme.rail-x - 16px; y: 0; height: parent.height; tone: Theme.rule; }
                VerticalLayout {
                    padding-top: 18px;
                    spacing: 2px;
                    alignment: start;
                    Caps { x: 28px; text: @tr("PREFERENCES"); height: 28px; vertical-alignment: center; }
                    Category { accessible-label: "prefs.nav.audio"; label: @tr("AUDIO"); current: root.page == "audio"; clicked => { root.select-page("audio"); } }
                    Category { accessible-label: "prefs.nav.view"; label: @tr("VIEW"); current: root.page == "view"; clicked => { root.select-page("view"); } }
                    Category { accessible-label: "prefs.nav.analysis"; label: @tr("ANALYSIS"); current: root.page == "analysis"; clicked => { root.select-page("analysis"); } }
                    Category { accessible-label: "prefs.nav.controller"; label: @tr("CONTROLLER"); current: root.page == "controller"; clicked => { root.select-page("controller"); } }
                    Category { accessible-label: "prefs.nav.keyboard"; label: @tr("KEYBOARD"); current: root.page == "keyboard"; clicked => { root.select-page("keyboard"); } }
                    Category { accessible-label: "prefs.nav.recording"; label: @tr("RECORDING"); current: root.page == "recording"; clicked => { root.select-page("recording"); } }
                    Category { accessible-label: "prefs.nav.advanced"; label: @tr("ADVANCED"); current: root.page == "advanced"; clicked => { root.select-page("advanced"); } }
                }
                Caps {
                    x: 28px; y: parent.height - 58px; width: parent.width - 36px; height: 50px;
                    vertical-alignment: bottom;
                    text: root.platform-note; font-size: 10px; wrap: word-wrap;
                }
            }
            VLine { tone: Theme.rule; }

            // ── Page ──
            VerticalLayout {
                horizontal-stretch: 1;
                padding-left: 24px;
                padding-right: 20px;
                padding-top: 14px;
                padding-bottom: 12px;
                spacing: 8px;

                HorizontalLayout {
                    height: 36px;
                    Text {
                        text: root.page == "audio" ? @tr("Audio") : root.page == "view" ? @tr("View") : root.page == "analysis" ? @tr("Analysis")
                            : root.page == "controller" ? @tr("Controller") : root.page == "keyboard" ? @tr("Keyboard") : root.page == "recording" ? @tr("Recording") : @tr("Advanced");
                        font-family: Theme.family; font-size: Theme.rank-b; font-weight: 600; color: Theme.bone;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.page != "keyboard": VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        Button { a11y-label: "prefs.reset"; label: @tr("RESET PAGE"); tooltip: @tr("Set everything on this page back to the defaults"); clicked => { root.act("reset-page"); } }
                    }
                }

                // ── Audio ──
                if root.page == "audio": Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: 8px;
                        Heading { text: @tr("Output"); note: root.audio-pending ? @tr("APPLIES AFTER RESTART") : ""; }
                        Row { label: @tr("Output device"); RadioList { accessible-label: "prefs.audio.device"; horizontal-stretch: 1; options: root.audio-devices; selected: root.audio-device; picked(i) => { root.choose("audio.device", i); } } }
                        Row { label: @tr("Buffer size"); Choice { accessible-label: "prefs.audio.buffer"; options: root.buffer-options; selected: root.buffer; picked(i) => { root.choose("audio.buffer", i); } } }
                        Row { label: @tr("Sample rate"); Choice { accessible-label: "prefs.audio.sample-rate"; options: root.rate-options; selected: root.rate; picked(i) => { root.choose("audio.rate", i); } } }
                        Row {
                            label: @tr("Headphones (cue)");
                            Choice { accessible-label: "prefs.audio.headphone-routing"; options: [@tr("AUTOMATIC"), @tr("OUTPUTS 3/4"), @tr("OFF")]; selected: root.headphones; picked(i) => { root.choose("audio.headphones", i); } }
                        }
                        Note { text: @tr("Automatic picks the controller's audio interface (DDJ-FLX10, DDJ-FLX4) when it is connected, else the system output. Headphones play on outputs 3/4 when the device has four outputs."); }
                        Heading { text: @tr("Now"); }
                        Text { text: root.audio-status; font-family: Theme.family; font-size: 14px; color: Theme.bone-2; wrap: word-wrap; }
                    }
                }

                // ── View ──
                if root.page == "view": Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: 8px;
                        Heading { text: @tr("Language and keys"); }
                        Row { label: @tr("Language"); Choice { accessible-label: "prefs.view.language"; options: [@tr("SYSTEM"), "ENGLISH", "DEUTSCH"]; selected: root.language; picked(i) => { root.choose("view.language", i); } } }
                        Row { label: @tr("Key notation"); Choice { accessible-label: "prefs.analysis.key-notation"; options: [@tr("CAMELOT  8A"), @tr("OPEN KEY  1M"), @tr("MUSICAL  Am")]; selected: root.notation; picked(i) => { root.choose("view.notation", i); } } }
                        Heading { text: @tr("Display"); note: root.scale-pending ? @tr("UI SCALE APPLIES AFTER RESTART") : ""; }
                        Row { label: @tr("Appearance"); Choice { accessible-label: "prefs.view.appearance"; options: [@tr("DARK"), @tr("LIGHT"), @tr("SYSTEM")]; selected: root.appearance; picked(i) => { root.choose("view.appearance", i); } } }
                        Row { label: @tr("UI scale"); Choice { accessible-label: "prefs.view.scale"; options: root.scale-options; selected: root.scale; picked(i) => { root.choose("view.scale", i); } } }
                        Row { label: @tr("Waveform colour"); Choice { accessible-label: "prefs.view.waveform-colour"; options: [@tr("3-BAND"), @tr("BLUE"), "RGB"]; selected: root.waveform; picked(i) => { root.choose("view.waveform", i); } } }
                        Row {
                            label: @tr("Bar counter");
                            RadioList {
                                accessible-label: "prefs.view.bar-counter";
                                horizontal-stretch: 1;
                                options: [@tr("Countdown to phrase end"), @tr("Countdown to next memory cue"), @tr("Count up")];
                                selected: root.bar-counter;
                                picked(i) => { root.choose("view.bar-counter", i); }
                            }
                        }
                        Row { label: @tr("Phrases"); Switch { accessible-label: "prefs.view.phrase-enlarged"; label: @tr("Show phrases on the waveforms"); on: root.phrases; toggled(v) => { root.flag("view.phrases", v); } } }
                        Heading { text: @tr("Accessibility"); }
                        Row { label: @tr("Colour"); Switch { accessible-label: "prefs.view.colour-blind"; label: @tr("Colour-blind-safe palette"); on: root.colorblind; toggled(v) => { root.flag("view.colorblind", v); } } }
                        Row { label: @tr("Contrast"); Switch { accessible-label: "prefs.view.high-contrast"; label: @tr("High contrast (bright light)"); on: root.high-contrast; toggled(v) => { root.flag("view.contrast", v); } } }
                        Row { label: @tr("Motion"); Switch { accessible-label: "prefs.view.reduced-motion"; label: @tr("Reduce motion"); on: root.reduced-motion; toggled(v) => { root.flag("view.motion", v); } } }
                        Row { label: @tr("Waveform zoom"); Choice { accessible-label: "prefs.view.zoom"; options: [@tr("4 S"), @tr("8 S"), @tr("16 S"), @tr("32 S")]; selected: root.zoom-span; picked(i) => { root.choose("view.zoom", i); } } }
                        Note { text: @tr("Seconds shown across the zoomed waveform when a track opens; the wheel still zooms each waveform."); }
                        Heading { text: @tr("Browser"); }
                        Row { label: @tr("Text size"); Choice { accessible-label: "prefs.view.font-size"; options: ["12", "14", "16", "18"]; selected: root.font-size; picked(i) => { root.choose("view.font-size", i); } } }
                        Row { label: @tr("Line spacing"); Choice { accessible-label: "prefs.view.line-space"; options: [@tr("COMPACT"), @tr("NORMAL"), @tr("ROOMY")]; selected: root.line-spacing; picked(i) => { root.choose("view.line-spacing", i); } } }
                    }
                }

                // ── Analysis ──
                if root.page == "analysis": Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: 8px;
                        Heading { text: @tr("Track analysis"); }
                        Row { label: @tr("BPM range"); Choice { accessible-label: "prefs.analysis.bpm-range"; options: root.bpm-options; selected: root.bpm-range; picked(i) => { root.choose("analysis.bpm", i); } } }
                        Note { text: @tr("Tempos are folded into this range: pick a lower range for hip-hop, a higher one for drum & bass."); }
                        Row { label: @tr("Key"); Switch { accessible-label: "prefs.analysis.key"; label: @tr("Detect the key"); on: root.detect-key; toggled(v) => { root.flag("analysis.key", v); } } }
                        Row { label: @tr("Phrases"); Switch { accessible-label: "prefs.analysis.phrase"; label: @tr("Detect phrases (intro, verse, chorus …)"); on: root.detect-phrases; toggled(v) => { root.flag("analysis.phrases", v); } } }
                        Row { label: @tr("New tracks"); Switch { accessible-label: "prefs.analysis.auto-analyse"; label: @tr("Analyse automatically when added"); on: root.auto-analyse; toggled(v) => { root.flag("analysis.auto", v); } } }
                        Note { text: @tr("Changes apply to tracks analysed from now on. Use ANALYSE in the player to analyse a track again."); }
                    }
                }

                // ── Controller ──
                if root.page == "controller": Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: 8px;
                        Heading { text: @tr("Decks"); }
                        Row { label: @tr("Tempo range"); Choice { accessible-label: "prefs.controller.tempo-range"; options: ["±6 %", "±10 %", "±16 %", @tr("WIDE")]; selected: root.tempo-range; picked(i) => { root.choose("deck.tempo-range", i); } } }
                        Row { label: @tr("Quantize"); Switch { accessible-label: "prefs.controller.quantize"; label: @tr("Quantize cues, loops and jumps to the beat"); on: root.deck-quantize; toggled(v) => { root.flag("deck.quantize", v); } } }
                        Row { label: @tr("Sync"); Choice { accessible-label: "prefs.controller.sync-mode"; options: [@tr("BEAT SYNC (TEMPO + PHASE)")]; selected: 0; } }
                        Row { label: @tr("Jog wheel"); Choice { accessible-label: "prefs.controller.jog-mode"; options: [@tr("VINYL"), @tr("PITCH BEND")]; selected: root.jog-mode; picked(i) => { root.choose("deck.jog-mode", i); } } }
                        Row { label: @tr("Auto cue"); Switch { accessible-label: "prefs.controller.auto-cue"; label: @tr("A loaded track waits at its first sound"); on: root.auto-cue; toggled(v) => { root.flag("deck.auto-cue", v); } } }
                        Heading { text: @tr("Mixer"); }
                        Row { label: @tr("EQ"); Choice { accessible-label: "prefs.controller.eq-mode"; options: [@tr("ISOLATOR"), @tr("CLASSIC EQ")]; selected: root.eq-mode; picked(i) => { root.choose("mixer.eq-mode", i); } } }
                        Row { label: @tr("Channel fader curve"); Choice { accessible-label: "prefs.controller.fader-curve"; options: [@tr("LINEAR"), @tr("SMOOTH"), @tr("SHARP")]; selected: root.fader-curve; picked(i) => { root.choose("mixer.fader-curve", i); } } }
                        Row { label: @tr("Crossfader curve"); Choice { accessible-label: "prefs.controller.crossfader-curve"; options: [@tr("CONSTANT POWER"), @tr("LINEAR"), @tr("CUT")]; selected: root.crossfader-curve; picked(i) => { root.choose("mixer.crossfader-curve", i); } } }
                        Row { label: @tr("Auto gain"); Switch { accessible-label: "prefs.controller.auto-gain"; label: @tr("Level tracks by their analysed loudness"); on: root.auto-gain; toggled(v) => { root.flag("mixer.auto-gain", v); } } }
                        Note { text: @tr("Deck and mixer settings apply at once and every time audio starts."); }
                        Heading { text: @tr("Detected"); }
                        if root.controllers.length == 0: Note { text: @tr("No MIDI controller found. Connect a DDJ-FLX10 or DDJ-FLX4 by USB; it is picked up within a few seconds."); }
                        for c in root.controllers: Text { text: c; font-family: Theme.family; font-size: 14px; color: Theme.bone; height: 24px; vertical-alignment: center; }
                        Heading { text: @tr("Mappings"); note: root.mapping-pending ? @tr("APPLIES AFTER RESTART") : ""; }
                        for m in root.mappings: Text { text: m; font-family: Theme.family; font-size: 13px; color: Theme.bone-2; height: 22px; vertical-alignment: center; overflow: elide; }
                        Row {
                            label: @tr("Own mapping file");
                            Text { horizontal-stretch: 1; text: root.mapping-file == "" ? @tr("None") : root.mapping-file; font-family: Theme.family; font-size: 13px; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                            Button { a11y-label: "prefs.controller.mapping-choose"; label: @tr("CHOOSE…"); tooltip: @tr("Pick a mapping file"); clicked => { root.act("mapping.choose"); } }
                            if root.mapping-file != "": Button { a11y-label: "prefs.controller.mapping-clear"; label: @tr("REMOVE"); tone: Theme.fault; tooltip: @tr("Use only the built-in mappings"); clicked => { root.act("mapping.clear"); } }
                        }
                        Note { text: @tr("A mapping file (TOML, see docs/controller-mappings.md) is loaded in addition to the built-in mappings and wins for its device."); }

                        Heading { text: @tr("MIDI monitor"); }
                        Row {
                            label: @tr("Monitor");
                            Switch { accessible-label: "prefs.controller.midi-monitor"; label: @tr("Show every MIDI message and what it does"); on: root.midi-monitor; toggled(v) => { root.flag("midi.monitor", v); } }
                            Rectangle { horizontal-stretch: 1; }
                            Button { a11y-label: "prefs.controller.midi-clear"; label: @tr("CLEAR"); tooltip: @tr("Empty the monitor"); clicked => { root.act("midi.clear"); } }
                        }
                        if root.midi-monitor: Rectangle {
                            accessible-role: list; accessible-label: "prefs.controller.midi-log";
                            accessible-value: root.midi-lines.length;
                            height: 160px;
                            background: Theme.ground-band;
                            Flickable {
                                content-height: max(self.height, root.midi-lines.length * 18px + 8px);
                                content-y: min(0px, self.height - self.content-height);
                                VerticalLayout {
                                    padding: 4px; alignment: start;
                                    for l in root.midi-lines: Text { height: 18px; text: l; font-family: "Menlo"; font-size: 11px; color: Theme.bone-2; overflow: elide; }
                                }
                            }
                            if root.midi-lines.length == 0: Note { text: @tr("Move a control on your controller."); horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Heading { text: @tr("MIDI learn"); }
                        Row {
                            label: @tr("Action");
                            ComboBox { accessible-label: "prefs.controller.learn-action"; horizontal-stretch: 1; model: root.learn-actions; current-index: root.learn-action; selected => { root.choose("learn.action", self.current-index); } }
                        }
                        Row { label: @tr("Deck / channel"); Choice { accessible-label: "prefs.controller.learn-deck"; options: [@tr("NONE"), "1", "2", "3", "4"]; selected: root.learn-deck; picked(i) => { root.choose("learn.deck", i); } } }
                        Row {
                            label: @tr("Control");
                            Text {
                                accessible-role: AccessibleRole.text; accessible-label: "prefs.controller.learn-result"; accessible-value: self.text;
                                horizontal-stretch: 1;
                                text: root.learn-result != "" ? root.learn-result : root.learn-active ? @tr("Move or press the control now …") : @tr("Press LEARN, then move the control");
                                font-family: Theme.family; font-size: 14px; color: root.learn-result != "" ? Theme.bone : Theme.bone-3; vertical-alignment: center; overflow: elide;
                            }
                            Button { a11y-label: "prefs.controller.learn"; label: root.learn-active ? @tr("STOP") : @tr("LEARN"); tone: Theme.attention; tooltip: @tr("Listen for the next control you move"); clicked => { root.act(root.learn-active ? "learn.stop" : "learn.start"); } }
                            Button { a11y-label: "prefs.controller.learn-save"; label: @tr("ADD TO MY MAPPING"); tone: Theme.live; tooltip: @tr("Write the learned control into your own mapping file"); clicked => { root.act("learn.save"); } }
                        }
                        if root.learn-entry != "": Text {
                            accessible-role: AccessibleRole.text; accessible-label: "prefs.controller.learn-entry"; accessible-value: self.text;
                            text: root.learn-entry; font-family: "Menlo"; font-size: 11px; color: Theme.bone-2; wrap: word-wrap;
                        }
                        Note { text: @tr("Learned controls go into {} and are used from the next start.", root.learn-file); }

                        Heading { text: "DDJ-FLX10"; }
                        Row { label: @tr("Fader start"); Choice { accessible-label: "prefs.controller.flx10-fader-start"; options: [@tr("OFF"), @tr("ON"), @tr("ON + SYNC")]; selected: root.flx10-fader-start; picked(i) => { root.choose("flx10.fader-start", i); } } }
                        Row { label: @tr("REC OUT"); Choice { accessible-label: "prefs.controller.flx10-rec-out"; options: [@tr("WITH MIC"), @tr("WITHOUT MIC")]; selected: root.flx10-rec-out; picked(i) => { root.choose("flx10.rec-out", i); } } }
                        Row { label: @tr("Jog display time"); Choice { accessible-label: "prefs.controller.flx10-time-mode"; options: [@tr("REMAINING"), @tr("ELAPSED")]; selected: root.flx10-time-mode; picked(i) => { root.choose("flx10.time-mode", i); } } }
                        Row { label: @tr("Slip"); Switch { accessible-label: "prefs.controller.flx10-slip-flashing"; label: @tr("Flash the jog ring while slip is on"); on: root.flx10-slip-flashing; toggled(v) => { root.flag("flx10.slip-flashing", v); } } }
                        Row { label: @tr("SLIP button"); Choice { accessible-label: "prefs.controller.flx10-slip-led"; options: [@tr("LIT"), @tr("BLINKING")]; selected: root.flx10-slip-led; picked(i) => { root.choose("flx10.slip-led", i); } } }
                        Row { label: @tr("Hot cue indicator"); Switch { accessible-label: "prefs.controller.flx10-virtual-deck"; label: @tr("Show hot cues on the jog display"); on: root.flx10-virtual-deck; toggled(v) => { root.flag("flx10.virtual-deck", v); } } }
                        Row { label: @tr("Jog ring colour"); Choice { accessible-label: "prefs.controller.flx10-jog-ring"; options: [@tr("MODE 1"), @tr("MODE 2"), @tr("MODE 3")]; selected: root.flx10-jog-ring; picked(i) => { root.choose("flx10.jog-ring", i); } } }
                        Row { label: @tr("USB output boost"); Choice { accessible-label: "prefs.controller.flx10-boost"; options: ["0 dB", "+3 dB", "+6 dB", "+9 dB", "+12 dB", "+15 dB"]; selected: root.flx10-boost; picked(i) => { root.choose("flx10.boost", i); } } }
                        Row {
                            label: "";
                            Button { a11y-label: "prefs.controller.flx10-apply"; label: @tr("WRITE TO DDJ-FLX10"); tone: Theme.live; tooltip: @tr("Send these settings to the connected DDJ-FLX10 over USB"); clicked => { root.act("flx10.apply"); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Note { accessible-role: AccessibleRole.text; accessible-label: "prefs.controller.flx10-wire"; accessible-value: self.text; text: root.flx10-wire; font-family: "Menlo"; }
                    }
                }

                // ── Keyboard ──
                if root.page == "keyboard": VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Field {
                            accessible-role: text-input;
                            accessible-label: "prefs.keyboard.search";
                            accessible-value: self.text;
                            horizontal-stretch: 1;
                            placeholder: @tr("SEARCH {} ACTIONS OR KEYS", root.key-count);
                            text <=> root.key-search;
                            edited(t) => { root.search-keys(t); }
                        }
                        Button { a11y-label: "prefs.keyboard.import"; label: @tr("IMPORT…"); tooltip: @tr("Load key bindings from a TOML file"); clicked => { root.act("keys.import"); } }
                        Button { a11y-label: "prefs.keyboard.export"; label: @tr("EXPORT…"); tooltip: @tr("Save all key bindings as a TOML file"); clicked => { root.act("keys.export"); } }
                        Button { a11y-label: "prefs.reset"; label: @tr("RESET ALL"); tone: Theme.fault; tooltip: @tr("Restore every default key binding"); clicked => { root.act("keys.reset-all"); } }
                    }
                    if root.key-message != "": HorizontalLayout {
                        spacing: 10px;
                        min-height: 30px;
                        VLine { weight: 2px; form: root.key-conflict ? "double" : "solid"; tone: root.key-conflict ? Theme.attention : Theme.live; }
                        Text { horizontal-stretch: 1; text: root.key-message; font-family: Theme.family; font-size: 14px; color: Theme.bone; vertical-alignment: center; wrap: word-wrap; }
                        if root.key-conflict: Button { label: @tr("REPLACE"); tone: Theme.attention; tooltip: @tr("Take the keys from the other action"); clicked => { root.act("keys.replace"); root.focus-keys(); } }
                        if root.key-conflict: Button { label: @tr("CANCEL"); tooltip: @tr("Keep the bindings as they are"); clicked => { root.act("keys.cancel"); root.focus-keys(); } }
                    }
                    Note { text: @tr("Click a binding (or pick one with ↑ ↓ and press Return), then press the new keys. Esc cancels, Backspace removes the binding; on a conflict Return replaces. ← → switch pages."); }
                    Rectangle {
                        vertical-stretch: 1;
                        HLine { y: 0; width: parent.width; tone: Theme.rule; }
                        Flickable {
                            accessible-role: list;
                            accessible-label: "prefs.keyboard.shortcut-list";
                            y: 1px; height: parent.height - 1px;
                            viewport-y <=> root.key-scroll;
                            init => { root.key-view-height = self.height; }
                            changed height => { root.key-view-height = self.height; }
                            VerticalLayout {
                            alignment: start;
                            for r in root.key-rows: Rectangle {
                                height: r.header ? 36px : 28px;
                                background: !r.header && (rt.has-hover || r.id == root.key-selected) ? Theme.ground-band : transparent;
                                if !r.header && r.id == root.key-selected: VLine { x: 0; y: 6px; height: parent.height - 12px; tone: Theme.attention; }
                                if r.header: Caps { x: 0; y: 14px; text: r.title; color: Theme.bone-2; }
                                if !r.header: Text {
                                    x: 12px; width: parent.width - 440px; height: parent.height;
                                    text: r.title; overflow: elide;
                                    font-family: Theme.family; font-size: 14px;
                                    color: r.id == root.recording-id ? Theme.bone : Theme.bone-2;
                                    vertical-alignment: center;
                                }
                                if !r.header && r.scope != "": Caps {
                                    x: parent.width - 420px; width: 76px; height: parent.height;
                                    text: r.scope; vertical-alignment: center; horizontal-alignment: right;
                                }
                                rt := TouchArea {
                                    enabled: !r.header;
                                    width: parent.width - 340px;
                                }
                                if !r.header: Rectangle {
                                    x: parent.width - 334px; y: 3px; width: 200px; height: parent.height - 6px;
                                    background: bt.has-hover ? Theme.plate-raised : Theme.plate;
                                    if r.id == root.recording-id: Rectangle {
                                        HLine { x: 0; y: 0; width: parent.width; tone: Theme.attention; form: "dashed"; }
                                        HLine { x: 0; y: parent.height - self.height; width: parent.width; tone: Theme.attention; form: "dashed"; }
                                        VLine { x: 0; y: 0; height: parent.height; tone: Theme.attention; form: "dashed"; }
                                        VLine { x: parent.width - self.width; y: 0; height: parent.height; tone: Theme.attention; form: "dashed"; }
                                    }
                                    VLine { x: 8px; y: 5px; height: parent.height - 10px; tone: r.custom ? Theme.w436 : Theme.rule-strong; form: r.binding == "" ? "half" : "solid"; }
                                    Text {
                                        x: 18px; width: parent.width - 24px; height: parent.height;
                                        text: r.id == root.recording-id ? @tr("PRESS KEYS…") : r.binding == "" ? @tr("NOT SET") : r.binding;
                                        overflow: elide;
                                        font-family: Theme.family; font-size: 13px; font-weight: 500; letter-spacing: 0.6px;
                                        color: r.id == root.recording-id ? Theme.attention : r.binding == "" ? Theme.bone-3 : Theme.bone;
                                        vertical-alignment: center;
                                    }
                                    bt := TipArea { tooltip: @tr("Click, then press the new keys"); mouse-cursor: pointer; clicked => { root.record-key(r.id); root.focus-keys(); } }
                                }
                                if !r.header && r.custom: PlateButton { x: parent.width - 126px; y: 1px; width: 90px; compact: true; label: @tr("DEFAULT"); tooltip: @tr("Back to the default binding"); clicked => { root.reset-key(r.id); } }
                                if !r.header && r.binding != "": Rectangle {
                                    x: parent.width - 26px; y: 4px; width: 20px; height: parent.height - 8px;
                                    background: ct.has-hover ? Theme.plate : transparent;
                                    Glyph { kind: "close"; tone: Theme.bone-3; x: 5px; y: (parent.height - 10px) / 2; }
                                    ct := TipArea { tooltip: @tr("Remove this binding"); mouse-cursor: pointer; clicked => { root.clear-key(r.id); } }
                                }
                            }
                            }
                        }
                    }
                }

                // ── Recording ──
                if root.page == "recording": Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: 8px;
                        Heading { text: @tr("Files"); }
                        Row { label: @tr("Format"); Choice { accessible-label: "prefs.recording.format"; options: ["WAV", "FLAC", "WAV + MP3"]; selected: root.rec-format; picked(i) => { root.choose("rec.format", i); } } }
                        if root.rec-note != "": Note { text: root.rec-note; }
                        Row {
                            label: @tr("Folder");
                            Text { horizontal-stretch: 1; text: root.rec-folder; font-family: Theme.family; font-size: 13px; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                            Button { a11y-label: "prefs.recording.folder"; label: @tr("CHOOSE…"); tooltip: @tr("Pick the folder for recordings"); clicked => { root.act("rec.folder"); } }
                        }
                        Row {
                            label: @tr("File name");
                            Field {
                                accessible-role: text-input;
                                accessible-label: "prefs.recording.name-pattern";
                                accessible-value: self.text;
                                horizontal-stretch: 1;
                                text: root.rec-pattern;
                                placeholder: "Mix {date} {time}";
                                accepted(t) => { root.text("rec.pattern", t); }
                            }
                        }
                        Note { text: @tr("{{date}}, {{time}} and {{n}} (number of the day) are filled in; Return saves. Example: {}", root.rec-example); }
                        Row { label: @tr("Recording level"); Choice { accessible-label: "prefs.recording.level"; options: root.rec-gain-options; selected: root.rec-gain; picked(i) => { root.choose("rec.gain", i); } } }
                        Heading { text: @tr("Automation"); }
                        Row { label: @tr("Split"); Switch { accessible-label: "prefs.recording.auto-split"; label: @tr("Split into one file per track when recording stops"); on: root.auto-split; toggled(v) => { root.flag("rec.split", v); } } }
                        Row { label: @tr("Start"); Switch { accessible-label: "prefs.recording.silence-start"; label: @tr("Start recording when sound starts"); on: root.silence-start; toggled(v) => { root.flag("rec.silence", v); } } }
                        Row { label: @tr("Stop"); Switch { accessible-label: "prefs.recording.silence-stop"; label: @tr("Stop recording after 30 seconds of silence"); on: root.silence-stop; toggled(v) => { root.flag("rec.silence-stop", v); } } }
                        Note { text: @tr("With automatic start, recording begins once the master carries sound for two seconds; stopping it by hand disarms it until the next start of the app."); }
                    }
                }

                // ── Advanced ──
                if root.page == "advanced": Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: 8px;
                        Heading { text: @tr("Library"); note: root.library-pending ? @tr("APPLIES AFTER RESTART") : ""; }
                        Row {
                            label: @tr("Location");
                            Text { horizontal-stretch: 1; text: root.library-path; font-family: Theme.family; font-size: 13px; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                            Button { a11y-label: "prefs.advanced.library-choose"; label: @tr("CHOOSE…"); tooltip: @tr("Pick the library file to open from the next start"); clicked => { root.act("library.choose"); } }
                            Button { a11y-label: "prefs.advanced.library-show"; label: @tr("SHOW"); tooltip: @tr("Show the library file in the file manager"); clicked => { root.act("library.show"); } }
                        }
                        Note { text: @tr("Choose the library file (library.sqlite) to open from the next start. The command-line option --library still wins."); }
                        Row {
                            label: @tr("rekordbox");
                            Text { horizontal-stretch: 1; text: @tr("Preferences and keyboard shortcuts"); font-family: Theme.family; font-size: 13px; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                            Button { a11y-label: "prefs.advanced.rekordbox-settings"; label: @tr("IMPORT"); tooltip: @tr("Take over the preferences and shortcuts of a rekordbox installation (rekordbox itself is not changed)"); clicked => { root.act("rekordbox.settings"); } }
                        }
                        Heading { text: @tr("Backups"); }
                        Row { label: @tr("At start"); Switch { accessible-label: "prefs.advanced.backup-on-start"; label: @tr("Back up the library every time the app starts"); on: root.backup-on-start; toggled(v) => { root.flag("adv.backup", v); } } }
                        Row {
                            label: @tr("Backups");
                            Text { horizontal-stretch: 1; text: root.backups-text; font-family: Theme.family; font-size: 13px; color: Theme.bone-2; vertical-alignment: center; }
                            Button { a11y-label: "prefs.advanced.backups"; label: @tr("BACK UP NOW"); tone: Theme.live; tooltip: @tr("Copy the library to the backups folder now"); clicked => { root.act("backup.now"); } }
                            Button { a11y-label: "prefs.advanced.backup-show"; label: @tr("SHOW"); tooltip: @tr("Show the backups folder"); clicked => { root.act("backup.show"); } }
                        }
                        Heading { text: @tr("Updates"); }
                        Row { label: @tr("Automatically"); Switch { accessible-label: "prefs.advanced.update-auto"; label: @tr("Check for updates automatically"); on: root.update-auto; toggled(v) => { root.flag("update.auto", v); } } }
                        Row { label: @tr("Pre-releases"); Switch { accessible-label: "prefs.advanced.update-prereleases"; label: @tr("Include pre-releases"); on: root.update-prereleases; toggled(v) => { root.flag("update.pre", v); } } }
                        Row {
                            label: @tr("Now");
                            Text { horizontal-stretch: 1; text: root.update-status; font-family: Theme.family; font-size: 13px; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                            Button { a11y-label: "prefs.advanced.update-check"; label: @tr("CHECK NOW"); tone: Theme.live; clicked => { root.act("update.check"); } }
                        }
                        Note { text: @tr("Only GitHub's public release list is read; nothing about you or your library is sent. Checks never run while a deck plays in Perform, and an update never interrupts a performance."); }
                    }
                }
            }
        }
    }

    // Tooltips draw above everything.
    TooltipLayer { }
}
