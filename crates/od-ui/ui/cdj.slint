// CDJ practice mode (SPEC §10.3c): per deck a club-player style screen —
// zoomed waveform, overview with cue marks, a large jog display with
// remaining time and bar counter, tempo with range and master tempo, hot
// cue / memory cue call, loop in / out / reloop, beat jump and search, and
// the big CUE and PLAY buttons with the player's cue rules. Software help
// (on-screen sync, stems, pad modes) is hidden, so the DJ practises the
// workflow of a club booth with the controller. A short checklist ticks
// itself off as the DJ works through it.
//
// The visual language is OpenDecks' own (emission lines on charcoal); only
// the structure of a player screen is followed.

import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { Caps, PlateButton, Fader, Jog, TipArea } from "controls.slint";
import { DeckView, LaneMotion, PadView, DeckTime } from "structs.slint";
import { WaveLane } from "wave.slint";

export struct CdjStep {
    text: string,
    done: bool,
}

export struct CdjItem {
    title: string,
    sub: string,
    // A folder or list to open (else a track to load).
    folder: bool,
}

export global Cdj {
    in-out property <bool> enabled;
    // Browse screen: deck it belongs to (0 = closed), where it is, rows.
    in property <int> browse-deck;
    in property <string> browse-title;
    in property <[CdjItem]> browse-items;
    callback browse(int);
    callback browse-open(int);
    callback browse-back();
    in property <[CdjStep]> steps;
    in-out property <bool> show-steps: true;
    // Per deck (index deck - 1): the beat of the bar at the playhead, 1..4,
    // from the beatgrid; 0 without grid.
    in property <[int]> beat-in-bar;
    // Player actions by keymap id without the deck prefix ("memory.next",
    // "loop.in", "loop.out", "loop.exit", "loop.4", "jump.fwd", "jump.back",
    // "keylock", "play").
    callback action(int, string);
    callback cue(int, bool);
    callback hot-cue(int, int, bool);
    callback search(int, float);
    callback tempo(int, float);
    callback tempo-range(int);
    callback set-enabled(bool);
}

// The player's keys: rounded plates with an emission line along the top
// when lit (our design language, the club player's operating logic). A key
// clicks; a hold key also reports press and release (search, CUE preview).
component Key inherits Rectangle {
    in property <string> label;
    in property <string> tooltip;
    in property <bool> on;
    in property <color> tone: Theme.attention;
    in property <length> key-h: 30px;
    callback clicked();
    callback held(bool);
    min-width: max(44px, t.preferred-width + 16px);
    height: root.key-h;
    border-radius: 6px;
    background: ta.pressed ? Theme.plate-raised : root.on ? root.tone.with-alpha(0.2) : ta.has-hover ? Theme.plate-raised.mix(Theme.plate, 0.5) : Theme.plate;
    border-width: 1px;
    border-color: root.on ? root.tone : Theme.rule;
    Rectangle { x: 8px; y: 1px; width: parent.width - 16px; height: 2px; border-radius: 1px; background: root.on || ta.pressed ? root.tone : transparent; }
    t := Text {
        text: root.label;
        font-family: Theme.family; font-size: 10px; font-weight: 600; letter-spacing: 1.1px;
        color: root.on ? Theme.bone : Theme.bone-2;
        horizontal-alignment: center; vertical-alignment: center;
    }
    ta := TipArea {
        tooltip: root.tooltip; mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.held(true); }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) { root.held(false); }
        }
    }
}

// A hot cue: a rounded key with its letter, lit in the cue colour when set.
component HotCueKey inherits Rectangle {
    in property <PadView> pad;
    callback pressed(bool);
    property <color> tone: Theme.cue-color(root.pad.cue-slot >= 0 ? root.pad.cue-slot : root.pad.index);
    height: 30px;
    min-width: 28px;
    border-radius: 6px;
    background: root.pad.set ? root.tone.with-alpha(ta.pressed ? 0.5 : 0.24) : (ta.pressed ? Theme.plate-raised : Theme.plate);
    border-width: 1px;
    border-color: root.pad.set ? root.tone : Theme.rule;
    Text {
        text: root.pad.caption;
        font-family: Theme.family; font-size: 13px; font-weight: 600;
        color: root.pad.set ? Theme.bone : Theme.bone-3;
        horizontal-alignment: center; vertical-alignment: center;
    }
    ta := TipArea {
        tooltip: root.pad.set ? root.pad.sub : @tr("Empty hot cue: press to set it");
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.pressed(true); }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) { root.pressed(false); }
        }
    }
}

// Large round CUE / PLAY keys with press and release (CUE previews while held).
component BigButton inherits Rectangle {
    in property <string> label;
    in property <bool> lit;
    in property <color> tone;
    in property <length> size: 64px;
    callback pressed(bool);
    width: root.size; height: root.size;
    border-radius: root.size / 2;
    background: ta.pressed ? root.tone.with-alpha(0.4) : root.lit ? root.tone.with-alpha(0.22) : Theme.plate;
    border-width: 2px;
    border-color: root.lit ? root.tone : Theme.rule-strong;
    Text {
        text: root.label;
        font-family: Theme.family; font-size: 12px; font-weight: 600; letter-spacing: 1.4px;
        color: root.lit ? Theme.bone : Theme.bone-2;
        horizontal-alignment: center; vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.pressed(true); }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) { root.pressed(false); }
        }
    }
}

// A small caption over a group of keys.
component GroupCaption inherits Text {
    font-family: Theme.family; font-size: 9px; font-weight: 600; letter-spacing: 1.2px;
    color: Theme.bone-3; horizontal-alignment: center;
}

// One readout of the display: caption over a value.
component DisplayValue inherits VerticalLayout {
    in property <string> caption;
    in property <string> value;
    in property <string> value-label;
    in property <length> font-size: 22px;
    in property <string> template: "000.00";
    in property <TextHorizontalAlignment> align: center;
    spacing: 0;
    alignment: center;
    GroupCaption { text: root.caption; horizontal-alignment: root.align; }
    Text {
        accessible-role: text; accessible-label: root.value-label; accessible-value: root.value;
        min-width: probe.preferred-width;
        text: root.value == "" ? "—" : root.value;
        font-family: Theme.family; font-size: root.font-size; font-weight: 600; color: Theme.bone;
        horizontal-alignment: root.align;
        probe := Text { visible: false; text: root.template; font-family: Theme.family; font-size: root.font-size; font-weight: 600; }
    }
}

// Beat position: four segments for the beats of the bar, the current one
// lit; the downbeat (1) in the accent colour, 2–4 in the deck colour, so the
// beats of two players can be matched by eye.
component BeatPosition inherits HorizontalLayout {
    in property <int> beat;
    in property <color> tone;
    spacing: 3px;
    height: 8px;
    for i in 4: Rectangle {
        property <bool> lit: root.beat == i + 1;
        property <color> on-tone: i == 0 ? Theme.attention : root.tone;
        horizontal-stretch: 1;
        background: self.lit ? self.on-tone : i == 0 ? Theme.attention.with-alpha(0.12) : Theme.plate;
        border-width: 1px;
        border-color: self.lit ? self.on-tone : i == 0 ? Theme.attention.with-alpha(0.45) : Theme.rule;
    }
}

export component CdjPlayer inherits Rectangle {
    in property <DeckView> deck;
    in property <LaneMotion> motion;
    in property <bool> mirror;
    callback zoom(float);
    callback zoom-reset();
    callback seek(float);
    callback load();
    property <int> n: root.deck.deck;
    property <color> tone: Theme.deck-color(root.n);
    // Short windows (laptop): a lower waveform and smaller CUE / PLAY.
    in property <bool> short;
    // Narrow windows: slimmer side columns so both players fit side by side.
    in property <bool> narrow;
    // One spacing for the whole player; the side columns share one width.
    property <length> gap: 6px;
    property <length> side: root.narrow ? 116px : 132px;
    accessible-role: groupbox;
    accessible-label: "deck\{root.n}.cdj";
    background: Theme.ground;
    clip: true;

    VerticalLayout {
        padding: 8px; spacing: root.gap;
        // ── Display: deck, title / artist, key, master, browse ──
        HorizontalLayout {
            height: 30px; spacing: 10px;
            Text { text: root.n; font-family: Theme.family; font-size: 22px; font-weight: 600; color: root.tone; vertical-alignment: center; }
            VerticalLayout {
                horizontal-stretch: 1; alignment: center;
                Text { text: root.deck.loaded || root.deck.loading ? root.deck.title : @tr("No track — browse and load"); font-family: Theme.family; font-size: 14px; font-weight: 600; color: Theme.bone; overflow: elide; }
                Text { text: root.deck.artist; font-family: Theme.family; font-size: 11px; color: Theme.bone-2; overflow: elide; }
            }
            if root.deck.master: Caps { text: "MASTER"; vertical-alignment: center; color: Theme.attention; }
            Caps { text: root.deck.key; vertical-alignment: center; color: Theme.bone; }
            VerticalLayout {
                alignment: center;
                Key {
                    accessible-label: "deck\{root.n}.cdj.browse"; accessible-role: button;
                    key-h: 26px; label: @tr("BROWSE"); on: Cdj.browse-deck == root.n;
                    tooltip: @tr("Browse the source and load a track, as on the player");
                    clicked => { Cdj.browse(root.n); }
                }
            }
        }
        // Zoomed waveform, the beat of the bar, the overview with cue marks.
        WaveLane {
            height: root.short ? 56px : 84px;
            deck: root.deck; motion: root.motion;
            zoom(d) => { root.zoom(d); }
            zoom-reset => { root.zoom-reset(); }
        }
        BeatPosition {
            accessible-role: progress-indicator;
            accessible-label: "cdj\{root.n}.beat-position";
            accessible-value: Cdj.beat-in-bar[root.n - 1];
            beat: root.deck.loaded ? Cdj.beat-in-bar[root.n - 1] : 0;
            tone: root.tone;
        }
        Rectangle {
            accessible-role: slider; accessible-label: "deck\{root.n}.cdj.overview"; accessible-value: root.deck.progress;
            height: root.short ? 24px : 30px;
            border-radius: 4px; clip: true;
            background: Theme.ground-band;
            Image { width: parent.width; height: parent.height; source: root.deck.overview; image-fit: fill; }
            Rectangle { x: 0; width: parent.width * root.deck.progress; height: parent.height; background: Theme.ground.with-alpha(0.55); }
            for c in root.deck.cues: VLine {
                x: parent.width * c.pos; height: parent.height; weight: c.slot >= 0 ? 2px : 1px;
                tone: c.slot >= 0 ? Theme.cue-tone(c.slot, c.tone) : Theme.attention;
                form: c.slot >= 0 ? "solid" : "dashed";
            }
            if root.deck.loaded: Rectangle { x: parent.width * root.deck.progress - 1px; width: 2px; height: parent.height; background: Theme.bone; }
            TouchArea { mouse-cursor: crosshair; clicked => { root.seek(clamp(self.mouse-x / self.width, 0, 1)); } }
            if !root.deck.loaded && !root.deck.loading: HorizontalLayout {
                alignment: center;
                VerticalLayout { alignment: center; PlateButton { accessible-label: "deck\{root.n}.cdj.load"; accessible-role: button; compact: true; label: @tr("LOAD SELECTED"); tone: root.tone; clicked => { root.load(); } } }
            }
        }
        // Display line: track search and cue call at the display, time and
        // tempo in the middle and right, like the player's screen.
        HorizontalLayout {
            spacing: root.gap;
            HorizontalLayout {
                width: root.side; spacing: 4px;
                VerticalLayout { alignment: center; Key {
                    accessible-label: "deck\{root.n}.cdj.search-back"; accessible-role: button;
                    horizontal-stretch: 1; min-width: 0; label: "◀◀"; tooltip: @tr("Search back while held");
                    held(down) => { Cdj.search(root.n, down ? -4 : 0); }
                } }
                VerticalLayout { alignment: center; Key {
                    accessible-label: "deck\{root.n}.cdj.search-fwd"; accessible-role: button;
                    horizontal-stretch: 1; min-width: 0; label: "▶▶"; tooltip: @tr("Search forward while held");
                    held(down) => { Cdj.search(root.n, down ? 4 : 0); }
                } }
            }
            HorizontalLayout {
                horizontal-stretch: 1; spacing: 4px; alignment: center;
                VerticalLayout { alignment: center; Key { accessible-label: "deck\{root.n}.cdj.call-prev"; accessible-role: button; label: "◀ CALL"; tooltip: @tr("Previous memory cue"); clicked => { Cdj.action(root.n, "memory.prev"); } } }
                DisplayValue { caption: DeckTime.label(); value: DeckTime.main(root.deck); value-label: "deck\{root.n}.cdj.time"; template: "-00:00.0"; }
                VerticalLayout { alignment: center; Key { accessible-label: "deck\{root.n}.cdj.call-next"; accessible-role: button; label: "CALL ▶"; tooltip: @tr("Next memory cue"); clicked => { Cdj.action(root.n, "memory.next"); } } }
            }
            HorizontalLayout {
                width: root.side; spacing: 8px; alignment: end;
                DisplayValue { caption: "BPM"; value: root.deck.bpm; value-label: "deck\{root.n}.cdj.bpm"; template: "000.00"; font-size: root.narrow ? 18px : 22px; align: right; }
                DisplayValue { caption: @tr("TEMPO"); value: root.deck.tempo; value-label: "deck\{root.n}.cdj.tempo-value"; template: "+00.0%"; font-size: 13px; align: right; }
            }
        }
        // ── Controls: loop / jump and CUE / PLAY left, hot cues over the jog
        // in the centre, tempo right ──
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: root.gap;
            VerticalLayout {
                width: root.side; spacing: root.gap;
                GroupCaption { text: @tr("LOOP"); }
                HorizontalLayout {
                    spacing: 4px;
                    Key { accessible-label: "deck\{root.n}.cdj.loop-in"; accessible-role: button; horizontal-stretch: 1; label: @tr("IN"); on: root.deck.looping; clicked => { Cdj.action(root.n, "loop.in"); } }
                    Key { accessible-label: "deck\{root.n}.cdj.loop-out"; accessible-role: button; horizontal-stretch: 1; label: @tr("OUT"); on: root.deck.looping; clicked => { Cdj.action(root.n, "loop.out"); } }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Key { accessible-label: "deck\{root.n}.cdj.reloop"; accessible-role: button; horizontal-stretch: 1; label: @tr("RELOOP"); tooltip: @tr("Reloop / exit the loop"); clicked => { Cdj.action(root.n, "loop.exit"); } }
                    Key { accessible-label: "deck\{root.n}.cdj.loop-4"; accessible-role: button; horizontal-stretch: 1; label: @tr("4 BEAT"); clicked => { Cdj.action(root.n, "loop.4"); } }
                }
                GroupCaption { text: @tr("BEAT JUMP"); }
                HorizontalLayout {
                    spacing: 4px;
                    Key { accessible-label: "deck\{root.n}.cdj.jump-back"; accessible-role: button; horizontal-stretch: 1; label: "◀ " + root.deck.jump-size; clicked => { Cdj.action(root.n, "jump.back"); } }
                    Key { accessible-label: "deck\{root.n}.cdj.jump-fwd"; accessible-role: button; horizontal-stretch: 1; label: root.deck.jump-size + " ▶"; clicked => { Cdj.action(root.n, "jump.fwd"); } }
                }
                Rectangle { vertical-stretch: 1; min-height: 0; }
                // CUE and PLAY, bottom left.
                HorizontalLayout {
                    spacing: root.gap; alignment: space-between;
                    BigButton {
                        accessible-label: "deck\{root.n}.cdj.cue"; accessible-role: button;
                        size: root.short ? 54px : 62px;
                        label: "CUE"; tone: Theme.attention; lit: root.deck.loaded && !root.deck.playing;
                        pressed(down) => { Cdj.cue(root.n, down); }
                    }
                    BigButton {
                        accessible-label: "deck\{root.n}.cdj.play"; accessible-role: button;
                        size: root.short ? 54px : 62px;
                        label: root.deck.playing ? "PAUSE" : "PLAY"; tone: Theme.live; lit: root.deck.playing;
                        pressed(down) => { if (down) { Cdj.action(root.n, "play"); } }
                    }
                }
            }
            // Hot cues in a row over the jog, the jog centred under them.
            VerticalLayout {
                horizontal-stretch: 1; spacing: root.gap;
                HorizontalLayout {
                    spacing: 4px;
                    for p in root.deck.pads-left: HotCueKey { pad: p; horizontal-stretch: 1; pressed(down) => { Cdj.hot-cue(root.n, p.index, down); } }
                    for p in root.deck.pads-right: HotCueKey { pad: p; horizontal-stretch: 1; pressed(down) => { Cdj.hot-cue(root.n, p.index, down); } }
                }
                jog-room := Rectangle {
                    vertical-stretch: 1;
                    min-height: 110px;
                    property <length> d: min(self.width, self.height);
                    // A thin ring around the platter in the deck colour while it plays.
                    Rectangle {
                        x: (parent.width - parent.d) / 2; y: (parent.height - parent.d) / 2;
                        width: parent.d; height: parent.d; border-radius: parent.d / 2;
                        border-width: 2px;
                        border-color: root.deck.playing ? root.tone.with-alpha(0.7) : Theme.rule;
                    }
                    Jog {
                        accessible-label: "deck\{root.n}.cdj.jog"; accessible-role: image;
                        size: parent.d - 10px;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        angle: root.deck.jog-angle; progress: root.deck.progress; playing: root.deck.playing; loaded: root.deck.loaded;
                        tone: root.tone;
                        top-text: root.deck.beat-pos;
                        main-text: DeckTime.main(root.deck);
                        sub-text: root.deck.phrase;
                    }
                }
            }
            // Tempo: range and master tempo over the fader, right.
            VerticalLayout {
                width: root.side; spacing: root.gap;
                GroupCaption { text: @tr("TEMPO"); }
                HorizontalLayout {
                    spacing: 4px;
                    Key { accessible-label: "deck\{root.n}.cdj.tempo-range"; accessible-role: button; horizontal-stretch: 1; label: root.deck.tempo-range; tooltip: @tr("Tempo range"); clicked => { Cdj.tempo-range(root.n); } }
                    Key { accessible-label: "deck\{root.n}.cdj.master-tempo"; accessible-role: button; horizontal-stretch: 1; label: "MT"; tooltip: @tr("Master tempo: the key stays when the tempo changes"); on: root.deck.keylock; tone: Theme.live; clicked => { Cdj.action(root.n, "keylock"); } }
                }
                HorizontalLayout {
                    alignment: center; vertical-stretch: 1;
                    Fader {
                        accessible-label: "deck\{root.n}.cdj.tempo"; accessible-role: slider; accessible-value: root.deck.tempo;
                        tone: root.tone; min-height: 90px;
                        value: (1 - root.deck.tempo-value) / 2;
                        tooltip: @tr("Tempo (up = slower, like a player)");
                        changed(v) => { Cdj.tempo(root.n, 1 - v * 2); }
                    }
                }
            }
        }
    }
    // Browse screen over the player: source → list → track.
    if Cdj.browse-deck == root.n: Rectangle {
        x: 0; y: 46px; width: parent.width; height: parent.height - 46px;
        background: Theme.ground-band;
        accessible-role: list; accessible-label: "deck\{root.n}.cdj.browse-list";
        VerticalLayout {
            padding: 8px; spacing: 4px;
            HorizontalLayout {
                height: 28px; spacing: 8px;
                Key { accessible-label: "deck\{root.n}.cdj.browse-back"; accessible-role: button; label: @tr("BACK"); clicked => { Cdj.browse-back(); } }
                Caps { text: Cdj.browse-title; vertical-alignment: center; color: Theme.attention; overflow: elide; }
            }
            Flickable {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    for it[i] in Cdj.browse-items: Rectangle {
                        accessible-role: list-item; accessible-label: "deck\{root.n}.cdj.browse-row\{i}"; accessible-value: it.title;
                        height: 30px;
                        background: ta.has-hover ? Theme.plate-raised : transparent;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 10px;
                            Text { text: it.folder ? "▸" : "♪"; width: 14px; color: it.folder ? Theme.attention : Theme.bone-3; vertical-alignment: center; font-family: Theme.family; }
                            Text { text: it.title; horizontal-stretch: 1; overflow: elide; color: Theme.bone; vertical-alignment: center; font-family: Theme.family; font-size: 13px; }
                            Text { text: it.sub; color: Theme.bone-2; vertical-alignment: center; font-family: Theme.family; font-size: 11px; }
                        }
                        ta := TouchArea { mouse-cursor: pointer; clicked => { Cdj.browse-open(i); } }
                    }
                }
            }
        }
    }
    VLine { x: root.mirror ? 0 : parent.width - 1px; height: parent.height; weight: 1px; tone: Theme.rule; }
}

// The guided checklist over the decks.
export component CdjSteps inherits Rectangle {
    accessible-role: list; accessible-label: "app.cdj.steps";
    height: Cdj.show-steps ? 30px : 0px;
    visible: Cdj.show-steps;
    background: Theme.ground-band;
    HorizontalLayout {
        padding-left: 12px; padding-right: 8px; spacing: 14px;
        Caps { text: @tr("CDJ PRACTICE"); color: Theme.attention; vertical-alignment: center; }
        for s[i] in Cdj.steps: HorizontalLayout {
            spacing: 5px;
            Rectangle {
                width: 12px; height: 12px; y: (parent.height - 12px) / 2;
                border-width: 1px; border-color: s.done ? Theme.live : Theme.rule-strong;
                background: s.done ? Theme.live.with-alpha(0.7) : transparent;
            }
            Text {
                text: (i + 1) + " " + s.text;
                font-family: Theme.family; font-size: 11px;
                color: s.done ? Theme.bone-3 : Theme.bone; vertical-alignment: center;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            PlateButton {
                accessible-label: "app.cdj.steps-hide"; accessible-role: button;
                compact: true; glyph: "close"; width: 30px; tooltip: @tr("Hide the checklist");
                clicked => { Cdj.show-steps = false; }
            }
        }
    }
    HLine { y: parent.height - 1px; tone: Theme.rule; }
}
