import { Theme } from "tokens.slint";
import { VLine, HLine, ProgressLine } from "lines.slint";
import { UpdateBar } from "update.slint";
import { DragGhost } from "drag.slint";
import { Caps, PlateButton, Field, LineToggle, Splitter, TooltipState } from "controls.slint";
import { TooltipLayer } from "tooltip.slint";
import { Sidebar } from "sidebar.slint";
import { TopBar } from "topbar.slint";
import { PreparePlayer } from "player.slint";
import { TrackTable } from "table.slint";
import { DeviceLine } from "devices.slint";
import { SetFlow } from "flow.slint";
import { PerformView } from "perform.slint";
import { PreferencesWindow, KeyRow } from "preferences.slint";
import { TreeRow, TrackRow, CueMark, HotCueSlot, DeviceRow, VolumeRow, FlowPoint, DeckView, ChannelView, PhraseMark, ExplorerRow, LaneMotion, MenuTarget } from "structs.slint";

export { PreferencesWindow, KeyRow }
// Perform panels (FX, sampler, pad modes).
import { FxUnitView } from "structs.slint";
export { FxUnitView }
export { Theme, TooltipState, TreeRow, TrackRow, CueMark, HotCueSlot, DeviceRow, VolumeRow, FlowPoint, DeckView, ChannelView, PhraseMark, ExplorerRow, LaneMotion, MenuTarget }

export struct ProposalRow {
    index: int,
    title: string,
    detail: string,
    // "cues" | "history"
    kind: string,
}

export struct NodeChoice {
    id: int,
    name: string,
    depth: int,
    checked: bool,
}

export struct RecordingRow {
    id: int,
    name: string,
    detail: string,
    path: string,
}

component SectionTitle inherits HorizontalLayout {
    in property <string> title;
    in property <string> sub;
    spacing: 14px;
    Text {
        text: root.title;
        font-family: Theme.family; font-size: Theme.rank-b; font-weight: 600;
        color: Theme.bone; vertical-alignment: center;
        overflow: elide;
    }
    Caps { text: root.sub; vertical-alignment: center; }
}

export component AppWindow inherits Window {
    title: "OpenDecks Session";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: root.kiosk ? 480px : 800px;
    min-height: root.kiosk ? 320px : 640px;
    background: Theme.ground;
    default-font-family: Theme.family;
    default-font-size: Theme.body;

    in-out property <string> mode: "prepare";
    in-out property <string> section: "library";
    in property <bool> kiosk;

    // Library.
    in property <[TreeRow]> tree;
    in property <int> selected-node: -1;
    in property <string> node-kind: "all";
    in property <string> node-title: "All tracks";
    in property <string> node-sub;
    in property <[TrackRow]> tracks;
    in property <string> sort-column: "date_added";
    in property <bool> sort-descending: true;
    in-out property <string> search-text;
    in property <string> smart-rule-text;
    in property <string> smart-rule-error;
    in property <bool> has-selection;
    // Browsing a stick: no editing.
    in property <bool> read-only;
    in property <int> selection-count;
    in property <int> focus-row: -1;
    // Explorer: folders on disk.
    in property <[ExplorerRow]> explorer;
    in property <int> explorer-selected: -1;
    // Explorer folder list also shows the files of all sub-folders.
    in-out property <bool> explorer-recursive;

    // Selected track.
    in property <bool> has-track;
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-bpm;
    in property <string> track-key;
    in property <string> track-duration;
    in property <string> grid-source;
    in property <bool> grid-locked;
    in property <bool> track-analysed;
    in property <image> track-overview;
    in property <[CueMark]> track-cues;
    in property <[HotCueSlot]> hot-cues-top;
    in property <[HotCueSlot]> hot-cues-bottom;
    in property <[PhraseMark]> track-phrases;
    // Pane sizes, set by the splitters and restored from the library.
    in-out property <length> sidebar-width: 260px;
    in-out property <length> upper-height: 0px;
    in property <[HotCueSlot]> hot-cues;
    in property <image> track-detail;
    in property <string> track-position;
    in property <float> cursor;
    in property <bool> previewing;

    // Sets.
    in property <[FlowPoint]> flow;
    in property <string> flow-total;
    in property <int> flow-selected: -1;
    in property <string> transition-note;

    // Devices.
    in property <[DeviceRow]> devices;
    in property <[VolumeRow]> volumes;
    in property <string> register-target;
    in property <int> device-selected: -1;
    in property <string> device-name;
    in property <bool> device-pioneer;
    in property <bool> device-opendecks;
    in property <[NodeChoice]> device-content;
    in property <[ProposalRow]> proposals;

    // Recordings.
    in property <[RecordingRow]> recordings;

    // Perform.
    in property <[DeckView]> decks;
    // Update notice (SPEC §14.1); "" = hidden.
    in property <string> update-state;
    in property <string> update-text;
    in property <float> update-progress;
    callback update-action(string);
    in property <[LaneMotion]> lane-motion;
    callback deck-zoom(int, float);
    callback deck-zoom-reset(int);
    in property <[DeckView]> decks-left;
    in property <[DeckView]> decks-right;
    in property <[ChannelView]> channels;
    in property <float> master-level: 1;
    in property <float> headphone-mix: 0.5;
    in property <float> headphone-level: 0.8;
    in property <bool> recording;
    in property <string> recording-time;
    in property <string> master-bpm;
    in property <float> crossfader: 0.5;
    in property <bool> engine-ready;
    in property <string> engine-message;
    in property <bool> focus-mode;
    in property <int> focus-deck: 1;
    // Library browser below the decks (kiosk: a separate screen).
    in-out property <bool> browser-open: true;
    // Perform panels (top bar FX / SAMPLER), persisted in the settings.
    in property <bool> fx-panel;
    in property <bool> sampler-panel;
    callback toggle-fx-panel();
    callback toggle-sampler-panel();
    // Beat FX units (1-based unit numbers) and the Colour FX selection.
    in property <[FxUnitView]> fx-units;
    in property <int> color-fx;
    callback fx-kind(int, int);
    callback fx-kind-step(int, int);
    callback fx-beats-step(int, int);
    callback fx-target(int, int);
    callback fx-level(int, float);
    callback fx-param(int, float);
    callback fx-on(int);
    callback fx-tap(int);
    callback fx-release(int, int, bool);
    callback color-fx-select(int);
    callback color-fx-step(int);
    in property <bool> small-screen;
    in property <image> ground-texture;

    // Status band.
    in property <float> analysis-progress;
    in property <string> analysis-text;
    in property <string> status-text;
    in property <string> undo-label;
    in property <string> redo-label;

    callback select-section(string);
    callback set-mode(string);
    callback select-node(int);
    callback toggle-node(int);
    callback add-to-node(int);
    callback create-node(string);
    callback rename-node(string);
    callback delete-node();
    callback remove-selected();
    callback search(string);
    callback set-smart-rule(string);
    callback sort(string);
    callback row-clicked(int, bool, bool);
    callback row-activated(int);
    callback row-dropped(int, int);
    callback row-rated(int, int);
    callback row-menu(int, string);
    in property <[MenuTarget]> menu-playlists;
    callback import-folder();
    callback import-rekordbox();
    callback explorer-select(int);
    callback explorer-toggle(int);
    callback explorer-add-root();
    callback explorer-remove-root(int);
    callback explorer-set-recursive(bool);
    callback seek(float);
    callback hot-cue(int);
    callback remove-hot-cue(int);
    callback add-memory-cue();
    callback grid-shift(int);
    callback grid-scale(float);
    callback grid-downbeat();
    callback grid-lock();
    callback analyse-selected();
    callback toggle-preview();
    callback flow-select(int);
    callback set-transition-note(string);
    callback sync-device(int);
    callback rebuild-device(int);
    callback eject-device(int);
    callback open-device(int);
    callback forget-device(int);
    callback register-volume(int);
    callback set-device-formats(bool, bool);
    callback set-device-node(int, bool);
    callback rename-device(string);
    callback accept-proposal(int);
    callback reject-proposal(int);
    callback undo();
    callback redo();
    callback reveal-recording(int);
    callback split-recording(int);
    callback find-moved-files();
    in property <int> missing-count;
    callback deck-toggle-play(int);
    callback deck-cue(int);
    callback deck-sync(int);
    callback deck-seek(int, float);
    callback deck-hot-cue(int, int);
    callback toggle-recording();
    callback set-deck-count(int);
    // Key text and modifiers: control (⌘ on macOS), meta (Ctrl on macOS, Super on Linux), alt, shift.
    callback key-pressed(string, bool, bool, bool, bool) -> bool;
    // Held keys (pitch bend) end on release.
    callback key-released(string);
    callback open-preferences();
    callback check-updates();
    // Appearance: the top-bar button cycles dark → light → system; Rust
    // hears every change of the effective palette (waveform images).
    callback cycle-appearance();
    callback appearance-changed(bool);
    property <bool> theme-light: Theme.light;
    changed theme-light => { root.appearance-changed(self.theme-light); }
    // Each change focuses the search field (keyboard: search).
    in property <int> search-focus;
    // Preferences > View: phrases on the waveforms.
    in property <bool> show-phrases: true;
    callback nudge(float);
    callback jump-start();
    callback deck-master(int);
    callback deck-keylock(int);
    callback deck-quantize(int);
    callback deck-slip(int);
    callback deck-tempo(int, float);
    callback deck-stem(int, string);
    callback deck-loop(int, float);
    callback deck-loop-exit(int);
    callback deck-loop-scale(int, float);
    callback deck-beat-jump(int, float);
    callback deck-load(int);
    callback mixer-trim(int, float);
    callback mixer-eq(int, int, float);
    callback mixer-cfx(int, float);
    callback mixer-fader(int, float);
    callback mixer-cue(int);
    callback set-crossfader(float);
    callback set-master-level(float);
    callback set-headphone-mix(float);
    callback set-headphone-level(float);

    // The platform menu bar (native on macOS; hidden elsewhere, where its
    // shortcuts still work). Preferences open with ⌘, / Ctrl+, as users
    // expect; every other shortcut goes through the configurable keymap.
    MenuBar {
        visible: Platform.os == OperatingSystemType.macos;
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("Preferences…"); shortcut: @keys(Control + ","); activated => { root.open-preferences(); } }
            MenuItem { title: @tr("Check for Updates…"); activated => { root.check-updates(); } }
            MenuItem { title: @tr("Add Music Folder…"); activated => { root.import-folder(); } }
            MenuItem { title: @tr("Import from rekordbox…"); activated => { root.import-rekordbox(); } }
        }
        Menu {
            title: @tr("View");
            MenuItem { title: @tr("Prepare"); activated => { root.set-mode("prepare"); } }
            MenuItem { title: @tr("Perform"); activated => { root.set-mode("perform"); } }
        }
    }

    forward-focus: keys;
    // The charcoal continuum behind everything (plain paper in light mode).
    if !Theme.light: Image { width: root.width; height: root.height; source: root.ground-texture; image-fit: fill; }
    keys := FocusScope {
        key-pressed(event) => {
            if (root.key-pressed(event.text, event.modifiers.control, event.modifiers.meta, event.modifiers.alt, event.modifiers.shift)) {
                return accept;
            }
            reject
        }
        key-released(event) => {
            root.key-released(event.text);
            reject
        }

        VerticalLayout {
            TopBar {
                open-preferences => { root.open-preferences(); }
                cycle-appearance => { root.cycle-appearance(); }
                mode: root.mode;
                kiosk: root.kiosk;
                show-record: root.mode != "perform";
                show-panels: root.mode == "perform";
                fx-panel: root.fx-panel;
                sampler-panel: root.sampler-panel;
                toggle-fx-panel => { root.toggle-fx-panel(); }
                toggle-sampler-panel => { root.toggle-sampler-panel(); }
                status: root.mode == "perform"
                    ? (root.engine-ready ? (root.master-bpm == "" ? @tr("NO MASTER") : @tr("MASTER {} BPM", root.master-bpm)) : root.engine-message)
                    : root.analysis-text;
                recording: root.recording;
                recording-time: root.recording-time;
                undo-label: root.undo-label;
                set-mode(m) => { root.set-mode(m); }
                toggle-recording => { root.toggle-recording(); }
                undo => { root.undo(); }
            }
            if root.update-state != "": UpdateBar {
                state: root.update-state;
                text: root.update-text;
                progress: root.update-progress;
                act(what) => { root.update-action(what); }
            }

            // ── Upper half: player (Prepare) or decks + mixer (Perform) ──
            upper := VerticalLayout {
            vertical-stretch: root.kiosk ? 1 : 0;
            preferred-height: root.upper-height > 0 ? root.upper-height : (root.mode == "prepare" ? 280px : 560px);
            if root.mode == "prepare": PreparePlayer {
                phrases: root.show-phrases ? root.track-phrases : [];
                info-width: root.sidebar-width;
                info-dragged(d) => { root.sidebar-width = clamp(root.sidebar-width + d, 180px, 480px); }
                info-reset => { root.sidebar-width = 260px; }
                has-track: root.has-track;
                title: root.track-title;
                artist: root.track-artist;
                bpm: root.track-bpm;
                key: root.track-key;
                duration: root.track-duration;
                position: root.track-position;
                grid-source: root.grid-source;
                grid-locked: root.grid-locked;
                analysed: root.track-analysed;
                read-only: root.read-only;
                overview: root.track-overview;
                detail: root.track-detail;
                cues: root.track-cues;
                hot-cues: root.hot-cues;
                cursor: root.cursor;
                previewing: root.previewing;
                seek(p) => { root.seek(p); }
                nudge(d) => { root.nudge(d); }
                hot-cue(s) => { root.hot-cue(s); }
                remove-hot-cue(s) => { root.remove-hot-cue(s); }
                add-memory-cue => { root.add-memory-cue(); }
                grid-shift(ms) => { root.grid-shift(ms); }
                grid-scale(f) => { root.grid-scale(f); }
                grid-downbeat => { root.grid-downbeat(); }
                grid-lock => { root.grid-lock(); }
                analyse => { root.analyse-selected(); }
                toggle-preview => { root.toggle-preview(); }
                jump-start => { root.jump-start(); }
            }
            if root.mode == "perform" && !(root.kiosk && root.browser-open): PerformView {
                vertical-stretch: 1;
                decks: root.decks;
                lane-motion: root.lane-motion;
                zoom(d, delta) => { root.deck-zoom(d, delta); }
                zoom-reset(d) => { root.deck-zoom-reset(d); }
                show-fx: root.fx-panel;
                fx-units: root.fx-units;
                color-fx: root.color-fx;
                fx-kind(u, k) => { root.fx-kind(u, k); }
                fx-kind-step(u, d) => { root.fx-kind-step(u, d); }
                fx-beats-step(u, d) => { root.fx-beats-step(u, d); }
                fx-target(u, t) => { root.fx-target(u, t); }
                fx-level(u, v) => { root.fx-level(u, v); }
                fx-param(u, v) => { root.fx-param(u, v); }
                fx-on(u) => { root.fx-on(u); }
                fx-tap(u) => { root.fx-tap(u); }
                fx-release(u, k, p) => { root.fx-release(u, k, p); }
                color-fx-select(i) => { root.color-fx-select(i); }
                color-fx-step(d) => { root.color-fx-step(d); }
                decks-left: root.decks-left;
                decks-right: root.decks-right;
                channels: root.channels;
                crossfader: root.crossfader;
                master-level: root.master-level;
                headphone-mix: root.headphone-mix;
                headphone-level: root.headphone-level;
                tight: root.small-screen;
                touch-size: root.kiosk;
                show-mixer: !root.small-screen;
                recording: root.recording;
                recording-time: root.recording-time;
                toggle-recording => { root.toggle-recording(); }
                toggle-play(d) => { root.deck-toggle-play(d); }
                cue(d) => { root.deck-cue(d); }
                sync(d) => { root.deck-sync(d); }
                master(d) => { root.deck-master(d); }
                keylock(d) => { root.deck-keylock(d); }
                quantize(d) => { root.deck-quantize(d); }
                slip(d) => { root.deck-slip(d); }
                seek(d, p) => { root.deck-seek(d, p); }
                hot-cue(d, s) => { root.deck-hot-cue(d, s); }
                tempo(d, v) => { root.deck-tempo(d, v); }
                stem(d, s) => { root.deck-stem(d, s); }
                loop(d, b) => { root.deck-loop(d, b); }
                loop-exit(d) => { root.deck-loop-exit(d); }
                loop-scale(d, f) => { root.deck-loop-scale(d, f); }
                beat-jump(d, b) => { root.deck-beat-jump(d, b); }
                load(d) => { root.deck-load(d); }
                trim(c, v) => { root.mixer-trim(c, v); }
                eq(c, b, v) => { root.mixer-eq(c, b, v); }
                cfx(c, v) => { root.mixer-cfx(c, v); }
                fader(c, v) => { root.mixer-fader(c, v); }
                channel-cue(c) => { root.mixer-cue(c); }
                set-crossfader(v) => { root.set-crossfader(v); }
                set-master-level(v) => { root.set-master-level(v); }
                set-headphone-mix(v) => { root.set-headphone-mix(v); }
                set-headphone-level(v) => { root.set-headphone-level(v); }
            }
            }
            if !root.kiosk: Splitter {
                horizontal: true;
                tooltip: @tr("Drag to resize, double-click to reset");
                dragged(d) => { root.upper-height = clamp(upper.height + d, upper.min-height, root.height - 260px); }
                reset => { root.upper-height = 0px; }
            }

            // ── Lower half: the browser ──
            if !root.kiosk || root.browser-open: HorizontalLayout {
                vertical-stretch: 1;
                min-height: 180px;
                if !root.kiosk: Sidebar {
                    width: root.sidebar-width;
                    tree: root.tree;
                    selected-node: root.selected-node;
                    section: root.section;
                    can-add: root.has-selection;
                    devices: root.devices;
                    volumes: root.volumes;
                    register-target: root.register-target;
                    device-selected: root.device-selected;
                    recordings-count: root.recordings.length;
                    explorer: root.explorer;
                    explorer-selected: root.explorer-selected;
                    explorer-select(i) => { root.explorer-select(i); }
                    explorer-toggle(i) => { root.explorer-toggle(i); }
                    explorer-add-root => { root.explorer-add-root(); }
                    explorer-remove-root(i) => { root.explorer-remove-root(i); }
                    select-node(id) => { root.select-node(id); }
                    toggle-node(id) => { root.toggle-node(id); }
                    add-to-node(id) => { root.add-to-node(id); }
                    create-node(k) => { root.create-node(k); }
                    select-section(s) => { root.select-section(s); }
                    open-device(id) => { root.open-device(id); }
                    sync-device(id) => { root.sync-device(id); }
                    eject-device(id) => { root.eject-device(id); }
                    register-volume(i) => { root.register-volume(i); }
                    import-folder => { root.import-folder(); }
                    import-rekordbox => { root.import-rekordbox(); }
                }
                if !root.kiosk: Splitter {
                    horizontal: false;
                    tooltip: @tr("Drag to resize, double-click to reset");
                    dragged(d) => { root.sidebar-width = clamp(root.sidebar-width + d, 180px, 480px); }
                    reset => { root.sidebar-width = 260px; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding-left: 14px;
                    padding-right: 12px;
                    padding-top: 8px;
                    spacing: 8px;

                    // List header: title, count, search and list actions.
                    if root.section == "library": HorizontalLayout {
                        spacing: 10px;
                        height: root.kiosk ? 44px : 32px;
                        if root.kiosk: PlateButton {
                            horizontal-stretch: 0; compact: true; tall: true;
                            label: @tr("DECKS"); tone: Theme.w486; tooltip: @tr("Back to the decks");
                            clicked => { root.browser-open = false; }
                        }
                        title := TextInput {
                            width: min(self.preferred-width + 8px, 360px);
                            text: root.node-title;
                            read-only: root.node-kind == "all" || root.node-kind == "explorer" || root.read-only;
                            font-family: Theme.family; font-size: 18px; font-weight: 600;
                            color: Theme.bone;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.rename-node(self.text); keys.focus(); }
                        }
                        Caps { text: root.node-sub; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        if root.node-kind == "all" && root.missing-count > 0 && !root.kiosk: PlateButton { horizontal-stretch: 0; compact: true; label: @tr("FIND {} MOVED FILES", root.missing-count); tone: Theme.fault; tooltip: @tr("Search a folder for tracks whose files have moved"); command: "browser.find.moved"; clicked => { root.find-moved-files(); } }
                        if root.node-kind == "all" && !root.kiosk: PlateButton { horizontal-stretch: 0; compact: true; label: @tr("ADD MUSIC"); glyph: "plus"; tone: Theme.live; tooltip: @tr("Add a music folder"); command: "browser.add.music"; clicked => { root.import-folder(); } }
                        if root.node-kind == "explorer": LineToggle {
                            horizontal-stretch: 0;
                            label: @tr("Include subfolders");
                            checked <=> root.explorer-recursive;
                            toggled(v) => { root.explorer-set-recursive(v); }
                        }
                        if root.node-kind != "all" && root.node-kind != "stick" && root.node-kind != "explorer" && !root.read-only && !root.kiosk: PlateButton { horizontal-stretch: 0; compact: true; label: @tr("DELETE"); tone: Theme.fault; tooltip: @tr("Delete the open list"); command: "browser.delete.list"; clicked => { root.delete-node(); } }
                        Field {
                            property <int> focus-request: root.search-focus;
                            changed focus-request => { self.focus-field(); }
                            width: 260px;
                            height: root.kiosk ? 44px : 32px;
                            placeholder: @tr("SEARCH  ⌘F");
                            text <=> root.search-text;
                            edited(t) => { root.search(t); }
                        }
                    }
                    if root.section == "library" && root.node-kind == "smart": VerticalLayout {
                        spacing: 4px;
                        Field {
                            placeholder: @tr("RULES, E.G.  bpm 120-126, key 8A~, genre house, rating >= 3, added < 30d");
                            text: root.smart-rule-text;
                            tone: Theme.w436;
                            accepted(t) => { root.set-smart-rule(t); }
                        }
                        if root.smart-rule-error != "": Text {
                            text: root.smart-rule-error;
                            font-family: Theme.family; font-size: 12px; color: Theme.fault;
                        }
                    }
                    if root.section == "library" && root.node-kind == "set" && root.mode == "prepare": SetFlow {
                        points: root.flow;
                        total: root.flow-total;
                        selected: root.flow-selected;
                        select(i) => { root.flow-select(i); }
                    }
                    if root.section == "library" && root.node-kind == "set" && root.flow-selected >= 0 && root.mode == "prepare": Field {
                        placeholder: @tr("TRANSITION NOTE FOR THE SELECTED POSITION — ENTER TO SAVE");
                        text: root.transition-note;
                        tone: Theme.attention;
                        accepted(t) => { root.set-transition-note(t); }
                    }
                    if root.section == "library": TrackTable {
                        vertical-stretch: 1;
                        rows: root.tracks;
                        sort-column: root.sort-column;
                        descending: root.sort-descending;
                        focus-row: root.focus-row;
                        show-position: root.node-kind == "playlist" || root.node-kind == "set";
                        empty-text: root.node-kind == "all"
                            ? @tr("Your library is empty. Use ADD MUSIC to add a folder, or import your rekordbox library once.")
                            : root.node-kind == "explorer"
                            ? @tr("No audio files in this folder.")
                            : @tr("No tracks here yet. Select tracks in All tracks and press + next to this list in the sidebar.");
                        sort(c) => { root.sort(c); }
                        row-clicked(i, c, s) => { root.row-clicked(i, c, s); keys.focus(); }
                        row-activated(i) => { root.row-activated(i); }
                        row-dropped(i, t) => { root.row-dropped(i, t); }
                        row-rated(i, n) => { root.row-rated(i, n); }
                        row-menu(i, a) => { root.row-menu(i, a); }
                        playlists: root.menu-playlists;
                    }
                    if root.section == "library" && root.node-kind == "all" && root.tracks.length == 0: HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        PlateButton { label: @tr("ADD MUSIC FOLDER"); tone: Theme.live; tooltip: @tr("Add a music folder"); command: "browser.add.music"; clicked => { root.import-folder(); } }
                        PlateButton { label: @tr("IMPORT FROM REKORDBOX"); tone: Theme.w486; tooltip: @tr("Import playlists, cues and grids from rekordbox"); command: "browser.import.rekordbox"; clicked => { root.import-rekordbox(); } }
                    }

                    // ── Devices section ──
                    if root.section == "devices": SectionTitle { title: @tr("USB STICKS"); sub: @tr("{} REGISTERED", root.devices.length); }
                    if root.section == "devices": Text {
                        text: @tr("Registered sticks are kept in sync automatically while they are plugged in. Every change to a playlist, cue or beatgrid reaches the stick within seconds.");
                        wrap: word-wrap; font-family: Theme.family; font-size: 14px; color: Theme.bone-2;
                    }
                    if root.section == "devices": HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 32px;
                        VerticalLayout {
                            width: 360px;
                            spacing: 6px;
                            for d in root.devices: DeviceLine {
                                device: d;
                                roomy: true;
                                selected: d.id == root.device-selected;
                                sync => { root.sync-device(d.id); }
                                eject => { root.eject-device(d.id); }
                                open => { root.open-device(d.id); }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                        if root.device-selected >= 0: VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 10px;
                            Field {
                                text: root.device-name;
                                placeholder: @tr("STICK NAME");
                                accepted(t) => { root.rename-device(t); }
                            }
                            Caps { text: @tr("FORMATS"); }
                            HorizontalLayout {
                                spacing: 18px;
                                LineToggle { label: @tr("Pioneer players (export.pdb)"); tooltip: @tr("Write the database Pioneer CDJs and XDJs read"); checked: root.device-pioneer; toggled(v) => { root.set-device-formats(v, root.device-opendecks); } }
                                LineToggle { label: @tr("OpenDecks"); tooltip: @tr("Write the OpenDecks library for other OpenDecks setups"); checked: root.device-opendecks; toggled(v) => { root.set-device-formats(root.device-pioneer, v); } }
                            }
                            Caps { text: @tr("CONTENT — LISTS ON THIS STICK"); }
                            Rectangle {
                                vertical-stretch: 1;
                                Flickable {
                                    VerticalLayout {
                                        alignment: start;
                                        for c in root.device-content: LineToggle {
                                            x: c.depth * 16px;
                                            label: c.name;
                                            checked: c.checked;
                                            toggled(v) => { root.set-device-node(c.id, v); }
                                        }
                                    }
                                }
                            }
                            if root.proposals.length > 0: Caps { text: @tr("CHANGES MADE ON PLAYERS — REVIEW"); color: Theme.attention; }
                            for p in root.proposals: HorizontalLayout {
                                spacing: 10px;
                                height: 44px;
                                VLine { weight: 2px; form: "double"; tone: Theme.attention; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text { text: p.title; font-family: Theme.family; font-size: 14px; font-weight: 600; color: Theme.bone; overflow: elide; }
                                    Text { text: p.detail; font-family: Theme.family; font-size: 12px; color: Theme.bone-3; overflow: elide; }
                                }
                                PlateButton { compact: true; label: p.kind == "history" ? @tr("IMPORT") : @tr("TAKE STICK CUES"); tone: Theme.live; tooltip: p.kind == "history" ? @tr("Import the play history from the stick") : @tr("Replace the library cues with the ones edited on the players"); clicked => { root.accept-proposal(p.index); } }
                                PlateButton { compact: true; label: p.kind == "history" ? @tr("DISMISS") : @tr("KEEP LIBRARY"); tooltip: p.kind == "history" ? @tr("Ignore this history") : @tr("Keep the library cues; the stick gets them at the next sync"); clicked => { root.reject-proposal(p.index); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                PlateButton { compact: true; label: @tr("SYNC NOW"); tone: Theme.live; tooltip: @tr("Sync this stick now"); command: "devices.sync"; clicked => { root.sync-device(root.device-selected); } }
                                PlateButton { compact: true; label: @tr("REBUILD STICK"); tone: Theme.attention; tooltip: @tr("Write the whole stick again from the library"); clicked => { root.rebuild-device(root.device-selected); } }
                                PlateButton { compact: true; label: @tr("FORGET"); tone: Theme.fault; tooltip: @tr("Stop keeping this stick in sync"); clicked => { root.forget-device(root.device-selected); } }
                            }
                        }
                    }

                    // ── Recordings section ──
                    if root.section == "recordings": SectionTitle { title: @tr("RECORDINGS"); sub: @tr("{} MIXES", root.recordings.length); }
                    if root.section == "recordings": VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 4px;
                        if root.recordings.length == 0: Text {
                            text: @tr("No recordings yet. Press RECORD in Perform, or the record button on your controller.");
                            wrap: word-wrap; font-family: Theme.family; font-size: 14px; color: Theme.bone-3;
                        }
                        for r in root.recordings: Rectangle {
                            height: 48px;
                            VLine { x: 0; y: 8px; height: parent.height - 16px; tone: Theme.w656; }
                            Text { x: 16px; y: 6px; text: r.name; font-family: Theme.family; font-size: 15px; font-weight: 600; color: Theme.bone; }
                            Caps { x: 16px; y: 28px; text: r.detail; }
                            TouchArea { width: parent.width - 260px; clicked => { root.reveal-recording(r.id); } }
                            HorizontalLayout {
                                x: parent.width - 250px; y: 8px; width: 250px; height: 26px;
                                spacing: 6px; alignment: end;
                                PlateButton { compact: true; label: @tr("SHOW FILE"); tooltip: @tr("Show the recording in the file manager"); clicked => { root.reveal-recording(r.id); } }
                                PlateButton { compact: true; label: @tr("SPLIT INTO TRACKS"); tone: Theme.w656; tooltip: @tr("Cut the recording into one file per played track"); clicked => { root.split-recording(r.id); } }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            // Status band.
            Rectangle {
                height: 26px;
                HLine { y: 0; width: parent.width; tone: Theme.rule; }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 16px;
                    if root.analysis-progress > 0 && root.analysis-progress < 1: ProgressLine {
                        width: 120px; y: 12px; height: 2px;
                        progress: root.analysis-progress; tone: Theme.attention;
                    }
                    Caps { text: root.analysis-text; vertical-alignment: center; }
                    Text {
                        horizontal-stretch: 1;
                        text: root.status-text;
                        font-family: Theme.family; font-size: 12px; color: Theme.bone-2;
                        vertical-alignment: center; overflow: elide;
                    }
                }
            }
        }
    }

    // The dragged track follows the pointer.
    DragGhost { }
    // Tooltips draw above everything.
    TooltipLayer { }
}
