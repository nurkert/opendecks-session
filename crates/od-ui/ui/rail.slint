// The off-centre rail: brand, sections and the library tree hang off one
// vertical calibrated line.

import { ListView } from "std-widgets.slint";
import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { Caps, Glyph } from "controls.slint";
import { TreeRow } from "structs.slint";

component SectionTick inherits Rectangle {
    in property <string> label;
    in property <string> sub;
    in property <bool> current;
    in property <color> tone: Theme.bone-3;
    callback clicked();
    height: 40px;

    // Tick on the rail.
    Rectangle {
        x: Theme.rail-x - 6px; y: 14px; width: root.current ? 18px : 12px; height: root.current ? 2px : 1px;
        background: root.current ? root.tone : Theme.bone-3;
        animate width { duration: Theme.motion ? 160ms : 0ms; easing: ease-out; }
    }
    Text {
        x: Theme.rail-x + 20px; y: 6px;
        text: root.label;
        font-family: Theme.family; font-size: 13px; font-weight: 600;
        letter-spacing: Theme.tracking-c;
        color: root.current ? Theme.bone : Theme.bone-2;
    }
    Caps {
        x: Theme.rail-x + 20px; y: 23px;
        text: root.sub;
        font-size: 10px;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component TreeItem inherits Rectangle {
    in property <TreeRow> item;
    in property <bool> selected;
    in property <bool> can-add;
    callback clicked();
    callback toggled();
    callback add();
    height: 26px;
    background: touch.has-hover ? Theme.plate : transparent;

    // Selection is a rail tick, not a fill.
    if root.selected: Rectangle {
        x: 0; y: parent.height / 2 - 1px; width: 8px; height: 2px;
        background: Theme.attention;
    }
    property <length> indent: 24px + root.item.depth * 14px;

    if root.item.has-children: Rectangle {
        x: root.indent - 16px; y: (parent.height - 12px) / 2; width: 12px; height: 12px;
        Glyph { x: 2px; y: 2px; width: 8px; height: 8px; kind: root.item.expanded ? "minus" : "plus"; tone: Theme.bone-3; }
        TouchArea { clicked => { root.toggled(); } }
    }
    name := Text {
        x: root.indent;
        width: parent.width - root.indent - 56px;
        height: parent.height;
        text: root.item.name;
        overflow: elide;
        font-family: Theme.family;
        font-size: 14px;
        font-weight: root.item.kind == "folder" || root.item.kind == "stick" ? 600 : 400;
        color: root.selected ? Theme.bone : Theme.bone-2;
        vertical-alignment: center;
    }
    // Kind marker: sets carry a sodium hairline, smart lists a dashed one.
    if root.item.kind == "stick": VLine {
        x: root.indent - 6px; y: 6px; height: parent.height - 12px; weight: 2px;
        tone: Theme.live; form: "solid";
    }
    if root.item.kind == "set" || root.item.kind == "smart": VLine {
        x: root.indent - 6px; y: 8px; height: parent.height - 16px; weight: 1px;
        tone: root.item.kind == "set" ? Theme.attention : Theme.w436;
        form: root.item.kind == "smart" ? "dashed" : "solid";
    }
    // Length bar proportional to playing time.
    if root.item.kind != "folder" && root.item.kind != "stick": Rectangle {
        x: root.indent; y: parent.height - 4px;
        width: max(2px, (parent.width - root.indent - 56px) * root.item.length-frac);
        height: 1px;
        background: Theme.rule-strong;
    }
    if root.item.on-device: Rectangle {
        x: parent.width - 46px; y: 9px; width: 1px; height: 8px; background: Theme.live;
    }
    Text {
        x: parent.width - 40px; width: 32px; height: parent.height;
        text: root.item.kind == "folder" ? "" : root.item.count;
        horizontal-alignment: right;
        font-family: Theme.family; font-size: 12px; color: Theme.bone-3;
        vertical-alignment: center;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    if root.can-add && touch.has-hover && (root.item.kind == "playlist" || root.item.kind == "set"): Rectangle {
        x: parent.width - 30px; y: 3px; width: 26px; height: parent.height - 6px;
        background: Theme.plate-raised;
        border-width: 1px; border-color: Theme.live;
        Glyph { kind: "plus"; tone: Theme.bone; }
        TouchArea { mouse-cursor: pointer; clicked => { root.add(); } }
    }
}

component ModeTab inherits Rectangle {
    in property <string> label;
    in property <bool> current;
    callback clicked();
    Rectangle {
        y: parent.height - 2px; height: 2px;
        background: root.current ? Theme.attention : transparent;
    }
    Text {
        text: root.label;
        font-family: Theme.family; font-size: 12px; font-weight: 600; letter-spacing: 2px;
        color: root.current ? Theme.bone : Theme.bone-3;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component Rail inherits Rectangle {
    in property <[TreeRow]> tree;
    in property <int> selected-node;
    in property <string> section;
    in property <bool> can-add;
    in property <string> mode;
    callback select-section(string);
    callback select-node(int);
    callback toggle-node(int);
    callback add-to-node(int);
    callback set-mode(string);

    VLine { x: Theme.rail-x; y: 18px; height: parent.height - 36px; weight: 1px; tone: Theme.rule-strong; }
    Rectangle { x: Theme.rail-x - 3px; y: 14px; width: 7px; height: 7px; border-radius: 3.5px; border-width: 1px; border-color: Theme.bone-3; }
    Rectangle { x: Theme.rail-x - 3px; y: parent.height - 21px; width: 7px; height: 7px; border-radius: 3.5px; border-width: 1px; border-color: Theme.bone-3; }

    VerticalLayout {
        padding-top: 30px;
        padding-bottom: 28px;
        spacing: 0;

        Rectangle {
            height: 58px;
            Text {
                x: Theme.rail-x + 20px; y: 2px;
                text: "OPENDECKS";
                font-family: Theme.family; font-size: 20px; font-weight: 600;
                letter-spacing: 3px; color: Theme.bone;
            }
            Caps { x: Theme.rail-x + 20px; y: 28px; text: "SESSION"; letter-spacing: 4px; }
        }

        SectionTick {
            label: @tr("LIBRARY"); sub: @tr("TRACKS & PLAYLISTS");
            current: root.section == "library"; tone: Theme.w486;
            clicked => { root.select-section("library"); }
        }
        SectionTick {
            label: @tr("DEVICES"); sub: @tr("USB STICKS");
            current: root.section == "devices"; tone: Theme.live;
            clicked => { root.select-section("devices"); }
        }
        SectionTick {
            label: @tr("RECORDINGS"); sub: @tr("MIXES");
            current: root.section == "recordings"; tone: Theme.w656;
            clicked => { root.select-section("recordings"); }
        }

        Rectangle { height: 14px; }
        Rectangle {
            height: 1px;
            HLine { x: Theme.rail-x; width: parent.width - Theme.rail-x - 12px; }
        }
        Rectangle { height: 8px; }

        ListView {
            vertical-stretch: 1;
            for row in root.tree: TreeItem {
                item: row;
                selected: root.selected-node == row.id && root.section == "library";
                can-add: root.can-add;
                clicked => { root.select-node(row.id); }
                toggled => { root.toggle-node(row.id); }
                add => { root.add-to-node(row.id); }
            }
        }

        Rectangle { height: 1px; HLine { x: Theme.rail-x; width: parent.width - Theme.rail-x - 12px; } }
        Rectangle { height: 10px; }

        // Work mode switch.
        Rectangle {
            height: 34px;
            HorizontalLayout {
                x: Theme.rail-x + 14px;
                width: parent.width - Theme.rail-x - 24px;
                spacing: 6px;
                ModeTab { label: @tr("PREPARE"); current: root.mode == "prepare"; clicked => { root.set-mode("prepare"); } }
                ModeTab { label: @tr("PERFORM"); current: root.mode == "perform"; clicked => { root.set-mode("perform"); } }
            }
        }
    }
}

