// Perform: the layout DJs know from performance mode, built on one grid.
// Zoomed three-band waveforms span the full width at the top; below them the
// odd decks, the mixer and the even decks sit edge to edge, separated only by
// shared 1px rules (no boxed panels, no gutters). Each deck: header, overview
// with phrase bar, jog display beside its state controls and tempo fader, and
// CUE / PLAY beside the hot cue pads, where DJs expect them.

import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { Caps, PlateButton, Glyph, Knob, Fader, Toggle, Transport, Jog } from "controls.slint";
import { DropZone } from "drag.slint";
import { DeckView, CueMark, HotCueSlot, ChannelView, PhraseMark, LaneMotion } from "structs.slint";

// Phrase bar: one labelled block per phrase.
export component PhraseBar inherits Rectangle {
    in property <[PhraseMark]> phrases;
    height: 14px;
    background: Theme.ground;
    for p in root.phrases: Rectangle {
        x: parent.width * p.pos;
        width: max(1px, parent.width * (p.end - p.pos) - 1px);
        background: p.tone.with-alpha(0.32);
        Rectangle { y: 0; height: 2px; background: p.tone; }
        Text {
            x: 3px; width: parent.width - 4px;
            text: parent.width > 30px ? p.label : "";
            font-family: Theme.family; font-size: 9px; font-weight: 600; letter-spacing: 0.8px;
            color: Theme.bone; vertical-alignment: center; overflow: clip;
        }
    }
}

// One zoomed, scrolling waveform lane with the deck's numeral in a gutter.
// The playhead is extrapolated per rendered frame from the published motion
// (position + speed) with animation-tick(), and three pre-rendered tiles are
// translated under it: smooth at the display rate, no per-frame rendering.
component WaveLane inherits Rectangle {
    in property <DeckView> deck;
    in property <LaneMotion> motion;
    callback zoom(float);
    callback zoom-reset();
    property <color> tone: Theme.deck-color(root.deck.deck);
    property <length> gutter: 44px;
    property <length> area: root.width - root.gutter;
    property <duration> base-tick;
    changed motion => { root.base-tick = animation-tick(); }
    // Playhead now (seconds); only depends on the frame clock while moving.
    property <float> now: root.motion.rate == 0 ? root.motion.pos : root.motion.pos + root.motion.rate * ((animation-tick() - root.base-tick) / 1ms);
    property <float> left-t: root.now - root.motion.span / 2;
    background: Theme.ground-band;
    clip: true;
    if root.motion.loaded: Image { x: root.gutter + (root.motion.t0 - root.left-t) / root.motion.span * root.area; width: root.area; height: parent.height; source: root.motion.tile0; image-fit: fill; }
    if root.motion.loaded: Image { x: root.gutter + (root.motion.t1 - root.left-t) / root.motion.span * root.area; width: root.area; height: parent.height; source: root.motion.tile1; image-fit: fill; }
    if root.motion.loaded: Image { x: root.gutter + (root.motion.t2 - root.left-t) / root.motion.span * root.area; width: root.area; height: parent.height; source: root.motion.tile2; image-fit: fill; }
    // Played audio left of the playhead is veiled.
    if root.motion.loaded: Rectangle { x: root.gutter; width: root.area / 2; height: parent.height; background: Theme.ground.with-alpha(0.45); }
    Rectangle {
        x: 0; y: 0; width: root.gutter; height: parent.height;
        background: Theme.ground;
        VLine { x: 0; height: parent.height; weight: 3px; tone: root.tone; form: root.deck.master ? "double" : "solid"; }
        Text {
            x: 8px; width: root.gutter - 12px; y: 4px;
            text: root.deck.deck;
            font-family: Theme.family; font-size: 18px; font-weight: 600; color: root.tone;
            horizontal-alignment: center;
        }
        if root.deck.master: Text {
            x: 8px; width: root.gutter - 12px; y: parent.height - 16px;
            text: "M";
            font-family: Theme.family; font-size: 10px; font-weight: 600; color: Theme.attention;
            horizontal-alignment: center;
        }
        VLine { x: parent.width - 1px; height: parent.height; weight: 1px; tone: Theme.rule; }
    }
    // Playhead at the centre of the waveform area.
    Rectangle {
        x: root.gutter + root.area / 2 - 1px; width: 2px; height: parent.height;
        background: root.deck.loaded ? Theme.bone : Theme.rule-strong;
    }
    if root.deck.loaded && root.deck.phrase != "": Text {
        x: root.gutter + root.area / 2 + 8px; y: 4px;
        text: root.deck.phrase;
        font-family: Theme.family; font-size: 10px; font-weight: 600; letter-spacing: 1px; color: Theme.bone;
    }
    if root.deck.loaded: Text {
        // Fixed width (template "-000.0"), right-aligned: digits never shift.
        x: parent.width - 64px; width: 56px; y: 4px;
        horizontal-alignment: right;
        text: root.deck.beat-pos;
        font-family: Theme.family; font-size: 11px; font-weight: 600; color: Theme.bone-2;
    }
    // Scroll to zoom; double-click resets.
    TouchArea {
        x: root.gutter; width: root.area;
        scroll-event(e) => {
            root.zoom(e.delta-y / 1px);
            accept
        }
        double-clicked => { root.zoom-reset(); }
    }
    HLine { y: parent.height - 1px; width: parent.width; tone: Theme.rule; }
}

// A hot cue pad: filled in the cue colour when set, letter and time/label.
export component Pad inherits Rectangle {
    in property <HotCueSlot> cue;
    callback pressed();
    property <color> tone: Theme.cue-color(root.cue.slot);
    height: 30px;
    background: root.cue.set
        ? (touch.pressed ? root.tone.with-alpha(0.5) : root.tone.with-alpha(touch.has-hover ? 0.34 : 0.24))
        : (touch.pressed ? Theme.plate-raised : touch.has-hover ? Theme.plate-raised.mix(Theme.plate, 0.5) : Theme.plate);
    border-width: 1px;
    border-color: root.cue.set ? root.tone.with-alpha(0.85) : Theme.rule;
    Rectangle { y: 0; height: 2px; background: root.cue.set ? root.tone : transparent; }
    Text {
        x: 8px; height: parent.height;
        text: root.cue.letter;
        font-family: Theme.family; font-size: 13px; font-weight: 600;
        color: root.cue.set ? Theme.bone : Theme.bone-3; vertical-alignment: center;
    }
    Text {
        x: 24px; width: parent.width - 28px; height: parent.height;
        text: root.cue.label != "" ? root.cue.label : root.cue.time;
        font-family: Theme.family; font-size: 11px;
        color: Theme.bone-2; vertical-alignment: center; overflow: elide;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.pressed(); } }
}

component Readout inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    in property <color> tone: Theme.bone;
    in property <length> size: 22px;
    in property <TextHorizontalAlignment> align: right;
    // Widest value this readout shows (e.g. "-00:00.0"): the readout keeps
    // that width so changing digits never move their neighbours.
    in property <string> template;
    spacing: 0;
    alignment: center;
    Caps { text: root.label; font-size: 10px; horizontal-alignment: root.align; }
    Text {
        min-width: probe.preferred-width;
        text: root.value == "" ? "—" : root.value;
        font-family: Theme.family; font-size: root.size; font-weight: 600;
        color: root.tone; horizontal-alignment: root.align;
        probe := Text { visible: false; text: root.template; font-family: Theme.family; font-size: root.size; font-weight: 600; }
    }
    if root.sub != "": Text {
        text: root.sub;
        font-family: Theme.family; font-size: 11px; font-weight: 500;
        color: Theme.bone-2; horizontal-alignment: root.align;
    }
}

// Track overview with progress veil, cue lines, needle search, phrase bar.
component Overview inherits VerticalLayout {
    in property <DeckView> deck;
    in property <length> wave-height: 36px;
    callback seek(float);
    callback load();
    spacing: 0;
    Rectangle {
        height: root.wave-height;
        background: Theme.ground-band;
        Image { width: parent.width; height: parent.height; source: root.deck.overview; image-fit: fill; }
        Rectangle { x: 0; width: parent.width * root.deck.progress; height: parent.height; background: Theme.ground.with-alpha(0.55); }
        for c in root.deck.cues: VLine {
            x: parent.width * c.pos; height: parent.height; weight: c.slot >= 0 ? 2px : 1px;
            tone: c.slot >= 0 ? Theme.cue-color(c.slot) : Theme.bone;
            form: c.slot >= 0 ? "solid" : "dashed";
        }
        if root.deck.loaded: Rectangle { x: parent.width * root.deck.progress - 1px; width: 2px; height: parent.height; background: Theme.bone; }
        TouchArea {
            mouse-cursor: crosshair;
            clicked => { root.seek(clamp(self.mouse-x / self.width, 0, 1)); }
            moved => { if (self.pressed) { root.seek(clamp(self.mouse-x / self.width, 0, 1)); } }
        }
        if !root.deck.loaded: Rectangle {
            background: Theme.ground-band;
            HorizontalLayout {
                alignment: center;
                PlateButton { compact: true; label: @tr("LOAD SELECTED"); tone: Theme.deck-color(root.deck.deck); clicked => { root.load(); } }
            }
        }
    }
    PhraseBar { phrases: root.deck.phrases; }
}

// Pad grid in two columns (A–D | E–H), pad mode named underneath.
component PadColumns inherits VerticalLayout {
    in property <DeckView> deck;
    in property <length> pad-h: 30px;
    callback hot-cue(int);
    horizontal-stretch: 3;
    spacing: 4px;
    HorizontalLayout {
        spacing: 4px;
        VerticalLayout {
            spacing: 4px;
            for c in root.deck.pads-left: Pad { height: root.pad-h; cue: c; pressed => { root.hot-cue(c.slot); } }
        }
        VerticalLayout {
            spacing: 4px;
            for c in root.deck.pads-right: Pad { height: root.pad-h; cue: c; pressed => { root.hot-cue(c.slot); } }
        }
    }
    Caps { text: "HOT CUE"; font-size: 10px; }
}

// Loop size and beat jump, as on the deck: size readout, ‹ ›, LOOP.
component LoopColumn inherits VerticalLayout {
    in property <DeckView> deck;
    in property <length> ctl-h: 26px;
    callback loop(float);
    callback loop-exit();
    callback loop-scale(float);
    callback beat-jump(float);
    width: 104px;
    spacing: 4px;
    alignment: center;
    Rectangle {
        height: root.ctl-h + 6px;
        background: Theme.plate;
        border-width: 1px;
        border-color: root.deck.looping ? Theme.w615 : Theme.rule;
        Text { text: root.deck.loop-size; font-family: Theme.family; font-size: 18px; font-weight: 600; color: Theme.bone; }
    }
    HorizontalLayout {
        spacing: 4px;
        Toggle { size: root.ctl-h; horizontal-stretch: 1; label: "½"; clicked => { root.loop-scale(0.5); } }
        Toggle { size: root.ctl-h; horizontal-stretch: 1; label: "2×"; clicked => { root.loop-scale(2); } }
    }
    Toggle {
        size: root.ctl-h; label: "LOOP"; on: root.deck.looping; tone: Theme.w615;
        clicked => { if (root.deck.looping) { root.loop-exit(); } else { root.loop(0); } }
    }
    HorizontalLayout {
        spacing: 4px;
        Toggle { size: root.ctl-h; horizontal-stretch: 1; label: "−4"; clicked => { root.beat-jump(-4); } }
        Toggle { size: root.ctl-h; horizontal-stretch: 1; label: "+4"; clicked => { root.beat-jump(4); } }
    }
}

component TransportColumn inherits VerticalLayout {
    in property <DeckView> deck;
    in property <length> size: 52px;
    callback cue();
    callback toggle-play();
    spacing: 14px;
    alignment: center;
    Transport { kind: "cue"; tone: Theme.attention; size: root.size; clicked => { root.cue(); } }
    Transport { kind: "play"; on: root.deck.playing; tone: Theme.live; size: root.size; clicked => { root.toggle-play(); } }
}

// SLIP / Q / KEY LOCK beside the platter, nearest the mixer.
component StateColumn inherits VerticalLayout {
    in property <DeckView> deck;
    in property <length> ctl-h: 26px;
    callback slip();
    callback quantize();
    callback keylock();
    width: 58px;
    spacing: 6px;
    alignment: space-between;
    Toggle { size: root.ctl-h; label: "SLIP"; on: root.deck.slip; tone: Theme.w405; clicked => { root.slip(); } }
    Toggle { size: root.ctl-h; label: "Q"; on: root.deck.quantize; tone: Theme.attention; clicked => { root.quantize(); } }
    Rectangle { vertical-stretch: 1; }
    Toggle { size: root.ctl-h; label: "MT"; on: root.deck.keylock; tone: Theme.w436; clicked => { root.keylock(); } }
}

// Slim tempo fader (for mouse use without a controller).
component TempoColumn inherits VerticalLayout {
    in property <DeckView> deck;
    callback tempo(float);
    width: 26px;
    spacing: 2px;
    Fader {
        vertical-stretch: 1;
        min-height: 80px;
        width: 26px;
        // Fader handle down = faster, as on the hardware.
        value: (1 - root.deck.tempo-value) / 2;
        tone: Theme.bone-3;
        changed(v) => { root.tempo(1 - v * 2); }
    }
}

export component DeckPanel inherits Rectangle {
    in property <DeckView> deck;
    in property <bool> compact;
    in property <bool> touch-size;
    // Even decks mirror the order so every deck's inner side faces the mixer.
    in property <bool> mirror;
    callback toggle-play();
    callback cue();
    callback sync();
    callback master();
    callback keylock();
    callback quantize();
    callback slip();
    callback seek(float);
    callback hot-cue(int);
    callback tempo(float);
    callback stem(string);
    callback loop(float);
    callback loop-exit();
    callback loop-scale(float);
    callback beat-jump(float);
    callback load();

    property <color> tone: Theme.deck-color(root.deck.deck);
    property <length> pad-h: root.touch-size ? (root.compact ? 34px : 40px) : 30px;
    property <length> ctl-h: root.touch-size ? 34px : 26px;
    property <length> jog: root.touch-size ? 176px : 164px;
    background: Theme.ground;
    min-height: body.min-height;
    preferred-height: body.preferred-height;

    body := VerticalLayout {
        padding-left: 14px; padding-right: 12px;
        padding-top: 8px; padding-bottom: 10px;
        spacing: 6px;
        alignment: start;

        // Header: numeral, title / artist, BPM, remaining / elapsed, key, SYNC / MASTER.
        HorizontalLayout {
            spacing: 14px;
            Text {
                text: root.deck.deck;
                font-family: Theme.family; font-size: root.compact ? 22px : 28px; font-weight: 600;
                color: root.tone; vertical-alignment: center;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 0px;
                Text {
                    text: root.deck.loaded ? root.deck.title : @tr("Not loaded");
                    font-family: Theme.family; font-size: root.compact ? 14px : 17px; font-weight: 600;
                    color: root.deck.loaded ? Theme.bone : Theme.bone-3;
                    overflow: elide;
                }
                Text {
                    text: root.deck.artist;
                    font-family: Theme.family; font-size: 12px; color: Theme.bone-2;
                    overflow: elide;
                }
            }
            Readout { label: "BPM"; template: "000.00"; value: root.deck.bpm; size: root.compact ? 18px : 22px; tone: root.deck.master ? Theme.attention : Theme.bone; }
            Readout { label: @tr("REMAIN"); template: "-00:00.0"; value: root.deck.remaining; sub: root.compact ? "" : root.deck.elapsed; size: root.compact ? 18px : 22px; }
            Readout { label: @tr("KEY"); template: "12A"; value: root.deck.key; size: root.compact ? 18px : 22px; }
            VerticalLayout {
                spacing: 3px;
                alignment: center;
                width: 70px;
                Toggle { size: 22px; label: "SYNC"; on: root.deck.sync; tone: Theme.w486; clicked => { root.sync(); } }
                Toggle { size: 22px; label: "MASTER"; on: root.deck.master; tone: Theme.attention; clicked => { root.master(); } }
            }
        }

        Overview {
            deck: root.deck;
            wave-height: root.compact ? 28px : 40px;
            seek(p) => { root.seek(p); }
            load => { root.load(); }
        }

        // Stem strip, toward the mixer.
        HorizontalLayout {
            spacing: 4px;
            if root.mirror || root.compact: Caps { text: root.deck.stems-busy ? @tr("SPLIT…") : "MUTE"; font-size: 10px; vertical-alignment: center; color: root.deck.stems-busy ? Theme.attention : Theme.bone-3; }
            if !root.mirror && !root.compact: Rectangle { horizontal-stretch: 1; }
            if !root.mirror && !root.compact: Caps { text: root.deck.stems-busy ? @tr("SPLIT…") : "MUTE"; font-size: 10px; vertical-alignment: center; color: root.deck.stems-busy ? Theme.attention : Theme.bone-3; }
            Toggle { size: 22px; width: 64px; label: "VOCAL"; on: root.deck.mute-vocal; tone: Theme.w546; enabled: root.deck.stems-available; clicked => { root.stem("vocal"); } }
            Toggle { size: 22px; width: 64px; label: "INST"; on: root.deck.mute-inst; tone: Theme.w656; enabled: root.deck.stems-available; clicked => { root.stem("inst"); } }
            Toggle { size: 22px; width: 64px; label: "DRUMS"; on: root.deck.mute-drums; tone: Theme.w486; enabled: root.deck.stems-available; clicked => { root.stem("drums"); } }
            Toggle { size: 22px; width: 64px; label: "BASS"; on: root.deck.mute-bass; tone: Theme.w405; enabled: root.deck.stems-available; clicked => { root.stem("bass"); } }
            if root.mirror || root.compact: Rectangle { horizontal-stretch: 1; }
        }

        // ── Full deck, outer → inner: pads | loop | CUE / PLAY | platter | state | tempo ──
        if !root.compact && !root.mirror: HorizontalLayout {
            spacing: 12px;
            PadColumns { deck: root.deck; pad-h: root.pad-h; hot-cue(s) => { root.hot-cue(s); } }
            LoopColumn { deck: root.deck; ctl-h: root.ctl-h; loop(b) => { root.loop(b); } loop-exit => { root.loop-exit(); } loop-scale(f) => { root.loop-scale(f); } beat-jump(b) => { root.beat-jump(b); } }
            TransportColumn { deck: root.deck; size: root.touch-size ? 60px : 52px; cue => { root.cue(); } toggle-play => { root.toggle-play(); } }
            Jog {
                size: root.jog; angle: root.deck.jog-angle; progress: root.deck.progress;
                playing: root.deck.playing; loaded: root.deck.loaded; tone: root.tone;
                top-text: root.deck.phrase; main-text: root.deck.loaded ? root.deck.bpm : "—";
                sub-text: root.deck.tempo + "  " + root.deck.tempo-range;
            }
            StateColumn { deck: root.deck; ctl-h: root.ctl-h; slip => { root.slip(); } quantize => { root.quantize(); } keylock => { root.keylock(); } }
            TempoColumn { deck: root.deck; tempo(v) => { root.tempo(v); } }
        }
        if !root.compact && root.mirror: HorizontalLayout {
            spacing: 12px;
            TempoColumn { deck: root.deck; tempo(v) => { root.tempo(v); } }
            StateColumn { deck: root.deck; ctl-h: root.ctl-h; slip => { root.slip(); } quantize => { root.quantize(); } keylock => { root.keylock(); } }
            Jog {
                size: root.jog; angle: root.deck.jog-angle; progress: root.deck.progress;
                playing: root.deck.playing; loaded: root.deck.loaded; tone: root.tone;
                top-text: root.deck.phrase; main-text: root.deck.loaded ? root.deck.bpm : "—";
                sub-text: root.deck.tempo + "  " + root.deck.tempo-range;
            }
            TransportColumn { deck: root.deck; size: root.touch-size ? 60px : 52px; cue => { root.cue(); } toggle-play => { root.toggle-play(); } }
            LoopColumn { deck: root.deck; ctl-h: root.ctl-h; loop(b) => { root.loop(b); } loop-exit => { root.loop-exit(); } loop-scale(f) => { root.loop-scale(f); } beat-jump(b) => { root.beat-jump(b); } }
            PadColumns { deck: root.deck; pad-h: root.pad-h; hot-cue(s) => { root.hot-cue(s); } }
        }

        // ── Compact deck (four decks / small screens) ──
        if root.compact: HorizontalLayout {
            spacing: 4px;
            Transport { kind: "cue"; tone: Theme.attention; size: root.touch-size ? 44px : 34px; clicked => { root.cue(); } }
            Transport { kind: "play"; on: root.deck.playing; tone: Theme.live; size: root.touch-size ? 44px : 34px; clicked => { root.toggle-play(); } }
            for c in root.deck.pads: Pad { horizontal-stretch: 1; height: root.pad-h; cue: c; pressed => { root.hot-cue(c.slot); } }
            Toggle { size: root.ctl-h; label: root.deck.loop-size; on: root.deck.looping; tone: Theme.w615; clicked => { if (root.deck.looping) { root.loop-exit(); } else { root.loop(0); } } }
            Toggle { size: root.ctl-h; label: "Q"; on: root.deck.quantize; tone: Theme.attention; clicked => { root.quantize(); } }
            Toggle { size: root.ctl-h; label: "MT"; on: root.deck.keylock; tone: Theme.w436; clicked => { root.keylock(); } }
        }
    }
    // Deck line along the outer edge.
    VLine { x: root.mirror ? parent.width - 3px : 0; y: 0; height: parent.height; weight: 3px; tone: root.tone; form: root.deck.master ? "double" : "solid"; }
    DropZone { width: parent.width; height: parent.height; id: root.deck.deck; tone: root.tone; }
    HLine { y: parent.height - 1px; width: parent.width; tone: Theme.rule; }
}

// One mixer channel, top to bottom: numeral, TRIM, HI, MID, LOW, CFX, CUE,
// meter + fader.
component ChannelStrip inherits Rectangle {
    in property <ChannelView> ch;
    in property <bool> compact;
    callback trim(float);
    callback eq(int, float);
    callback cfx(float);
    callback fader(float);
    callback cue();
    property <color> tone: Theme.deck-color(root.ch.channel);
    width: 50px;
    VerticalLayout {
        spacing: 2px;
        Text { text: root.ch.channel; font-family: Theme.family; font-size: 14px; font-weight: 600; color: root.tone; horizontal-alignment: center; }
        Knob { label: "TRIM"; value: root.ch.trim; size: root.compact ? 16px : 22px; changed(v) => { root.trim(v); } }
        Knob { label: "HI"; value: root.ch.high; size: root.compact ? 16px : 22px; tone: Theme.w486; changed(v) => { root.eq(2, v); } }
        Knob { label: "MID"; value: root.ch.mid; size: root.compact ? 16px : 22px; tone: Theme.w546; changed(v) => { root.eq(1, v); } }
        Knob { label: "LOW"; value: root.ch.low; size: root.compact ? 16px : 22px; tone: Theme.w656; changed(v) => { root.eq(0, v); } }
        Knob { label: "CFX"; value: root.ch.cfx; size: root.compact ? 16px : 22px; tone: Theme.w405; changed(v) => { root.cfx(v); } }
        Rectangle { height: 2px; }
        Toggle { size: 22px; label: "CUE"; on: root.ch.cue; tone: Theme.attention; clicked => { root.cue(); } }
        HorizontalLayout {
            vertical-stretch: 1;
            min-height: root.compact ? 36px : 64px;
            spacing: 3px;
            alignment: center;
            // Level meter: amber near the top, red at clip.
            Rectangle {
                width: 4px;
                background: Theme.ground;
                Rectangle {
                    y: parent.height * (1 - clamp(root.ch.level, 0, 1));
                    height: parent.height * clamp(root.ch.level, 0, 1);
                    background: root.ch.peak > 0.99 ? Theme.fault : root.ch.level > 0.8 ? Theme.attention : Theme.live;
                }
            }
            Fader { value: root.ch.fader; tone: root.tone; changed(v) => { root.fader(v); } }
        }
    }
}

// Horizontal crossfader.
component Crossfader inherits Rectangle {
    in-out property <float> value: 0.5;
    callback changed(float);
    height: 26px;
    Rectangle { x: 0; y: parent.height / 2 - 1px; width: parent.width; height: 2px; background: Theme.rule-strong; }
    Rectangle { x: parent.width / 2; y: 5px; width: 1px; height: parent.height - 10px; background: Theme.bone-3; }
    Rectangle {
        x: (parent.width - 14px) * root.value; y: 2px; width: 14px; height: parent.height - 4px;
        background: Theme.plate-raised; border-width: 1px; border-color: touch.has-hover ? Theme.bone-2 : Theme.bone-3;
        Rectangle { x: 6px; width: 2px; y: 3px; height: parent.height - 6px; background: Theme.bone; }
    }
    touch := TouchArea {
        mouse-cursor: ew-resize;
        moved => { if (self.pressed) { root.value = clamp((self.mouse-x - 7px) / (root.width - 14px), 0, 1); root.changed(root.value); } }
        double-clicked => { root.value = 0.5; root.changed(0.5); }
    }
}

// The mixer column between the decks: channel strips only.
export component MixerPanel inherits Rectangle {
    in property <[ChannelView]> channels;
    in property <bool> compact;
    callback trim(int, float);
    callback eq(int, int, float);
    callback cfx(int, float);
    callback fader(int, float);
    callback cue(int);
    background: Theme.ground-band;
    min-width: lay.min-width;
    preferred-width: lay.preferred-width;
    lay := HorizontalLayout {
        padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 10px;
        spacing: 6px;
        alignment: center;
        for c in root.channels: ChannelStrip {
            ch: c;
            compact: root.compact;
            trim(v) => { root.trim(c.channel, v); }
            eq(b, v) => { root.eq(c.channel, b, v); }
            cfx(v) => { root.cfx(c.channel, v); }
            fader(v) => { root.fader(c.channel, v); }
            cue => { root.cue(c.channel); }
        }
    }
    HLine { y: parent.height - 1px; width: parent.width; tone: Theme.rule; }
}

// Global bar under the decks: headphones (left of centre), crossfader under
// the mixer, master out and recording on the right.
component GlobalBar inherits Rectangle {
    in property <float> crossfader: 0.5;
    in property <float> master-level: 1;
    in property <float> headphone-mix: 0.5;
    in property <float> headphone-level: 0.8;
    in property <length> centre-width: 200px;
    in property <bool> recording;
    in property <string> recording-time;
    callback set-crossfader(float);
    callback set-master-level(float);
    callback set-headphone-mix(float);
    callback set-headphone-level(float);
    callback toggle-recording();
    height: 46px;
    background: Theme.ground;
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px;
        spacing: 0;
        HorizontalLayout {
            width: (root.width - 28px - max(160px, root.centre-width)) / 2;
            alignment: end;
            spacing: 14px;
            padding-right: 18px;
            Caps { text: @tr("PHONES"); vertical-alignment: center; }
            Knob { label: "MIX"; size: 20px; minimum: 0; maximum: 1; default-value: 0.5; value: root.headphone-mix; changed(v) => { root.set-headphone-mix(v); } }
            Knob { label: @tr("LEVEL"); size: 20px; minimum: 0; maximum: 1; default-value: 0.8; value: root.headphone-level; changed(v) => { root.set-headphone-level(v); } }
        }
        VerticalLayout {
            width: max(160px, root.centre-width);
            alignment: center;
            Crossfader { value: root.crossfader; changed(v) => { root.set-crossfader(v); } }
        }
        HorizontalLayout {
            width: (root.width - 28px - max(160px, root.centre-width)) / 2;
            alignment: end;
            spacing: 12px;
            padding-left: 18px;
            Caps { text: @tr("MASTER OUT"); vertical-alignment: center; }
            Knob { label: ""; size: 20px; minimum: 0; maximum: 1; default-value: 1; value: root.master-level; tone: Theme.attention; changed(v) => { root.set-master-level(v); } }
            Rectangle { width: 10px; }
            // Recording, one click away.
            Rectangle {
                width: 30px;
                Rectangle {
                    x: 3px; y: (parent.height - 24px) / 2; width: 24px; height: 24px; border-radius: 12px;
                    border-width: 1px; border-color: root.recording ? Theme.fault : Theme.rule-strong;
                    background: rt.has-hover ? Theme.plate : transparent;
                    Rectangle { x: 7px; y: 7px; width: 10px; height: 10px; border-radius: 5px; background: root.recording ? Theme.fault : Theme.bone-3; }
                }
                rt := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-recording(); } }
            }
            Text {
                text: root.recording ? root.recording-time : "00:00:00";
                font-family: Theme.family; font-size: 13px; font-weight: 600;
                color: root.recording ? Theme.bone : Theme.bone-3; vertical-alignment: center;
            }
        }
    }
    HLine { y: parent.height - 1px; width: parent.width; tone: Theme.rule; }
}

export component PerformView inherits Rectangle {
    in property <[DeckView]> decks;
    in property <[DeckView]> decks-left;
    in property <[DeckView]> decks-right;
    in property <[ChannelView]> channels;
    in property <[LaneMotion]> lane-motion;
    callback zoom(int, float);
    callback zoom-reset(int);
    in property <float> crossfader: 0.5;
    in property <float> master-level: 1;
    in property <float> headphone-mix: 0.5;
    in property <float> headphone-level: 0.8;
    in property <bool> tight;
    in property <bool> touch-size;
    in property <bool> show-mixer: true;
    // Too narrow for the full deck layout: decks go compact.
    property <bool> narrow: root.width < 1300px;
    in property <bool> recording;
    in property <string> recording-time;
    callback toggle-recording();
    callback toggle-play(int);
    callback cue(int);
    callback sync(int);
    callback master(int);
    callback keylock(int);
    callback quantize(int);
    callback slip(int);
    callback seek(int, float);
    callback hot-cue(int, int);
    callback tempo(int, float);
    callback stem(int, string);
    callback loop(int, float);
    callback loop-exit(int);
    callback loop-scale(int, float);
    callback beat-jump(int, float);
    callback load(int);
    callback trim(int, float);
    callback eq(int, int, float);
    callback cfx(int, float);
    callback fader(int, float);
    callback channel-cue(int);
    callback set-crossfader(float);
    callback set-master-level(float);
    callback set-headphone-mix(float);
    callback set-headphone-level(float);
    background: Theme.ground;

    VerticalLayout {
        spacing: 0;
        // Zoomed waveforms; they take any spare height.
        for d in root.decks: WaveLane {
            deck: d;
            motion: root.lane-motion[d.deck - 1];
            zoom(delta) => { root.zoom(d.deck, delta); }
            zoom-reset => { root.zoom-reset(d.deck); }
            min-height: root.tight ? 40px : root.decks.length > 2 ? 40px : 56px;
            preferred-height: root.tight ? 46px : root.decks.length > 2 ? 50px : 72px;
            vertical-stretch: 1;
        }
        // Decks (odd left, even right) edge to edge with the mixer.
        HorizontalLayout {
            spacing: 0;
            vertical-stretch: 0;
            VerticalLayout {
                // Both deck columns share the space equally, whatever they show.
                horizontal-stretch: 1;
                preferred-width: 0px;
                spacing: 0;
                for d in root.decks-left: DeckPanel {
                    deck: d;
                    compact: root.tight || root.narrow || root.decks.length > 2;
                    touch-size: root.touch-size;
                    toggle-play => { root.toggle-play(d.deck); }
                    cue => { root.cue(d.deck); }
                    sync => { root.sync(d.deck); }
                    master => { root.master(d.deck); }
                    keylock => { root.keylock(d.deck); }
                    quantize => { root.quantize(d.deck); }
                    slip => { root.slip(d.deck); }
                    seek(p) => { root.seek(d.deck, p); }
                    hot-cue(s) => { root.hot-cue(d.deck, s); }
                    tempo(v) => { root.tempo(d.deck, v); }
                    stem(s) => { root.stem(d.deck, s); }
                    loop(b) => { root.loop(d.deck, b); }
                    loop-exit => { root.loop-exit(d.deck); }
                    loop-scale(f) => { root.loop-scale(d.deck, f); }
                    beat-jump(b) => { root.beat-jump(d.deck, b); }
                    load => { root.load(d.deck); }
                }
            }
            VLine { weight: 1px; tone: Theme.rule; }
            mixer := MixerPanel {
                visible: root.show-mixer;
                width: root.show-mixer ? self.preferred-width : 0px;
                horizontal-stretch: 0;
                compact: root.tight || root.narrow || root.decks.length > 2;
                channels: root.channels;
                trim(c, v) => { root.trim(c, v); }
                eq(c, b, v) => { root.eq(c, b, v); }
                cfx(c, v) => { root.cfx(c, v); }
                fader(c, v) => { root.fader(c, v); }
                cue(c) => { root.channel-cue(c); }
            }
            if root.show-mixer: VLine { weight: 1px; tone: Theme.rule; }
            VerticalLayout {
                // Both deck columns share the space equally, whatever they show.
                horizontal-stretch: 1;
                preferred-width: 0px;
                spacing: 0;
                for d in root.decks-right: DeckPanel {
                    deck: d;
                    mirror: true;
                    compact: root.tight || root.narrow || root.decks.length > 2;
                    touch-size: root.touch-size;
                    toggle-play => { root.toggle-play(d.deck); }
                    cue => { root.cue(d.deck); }
                    sync => { root.sync(d.deck); }
                    master => { root.master(d.deck); }
                    keylock => { root.keylock(d.deck); }
                    quantize => { root.quantize(d.deck); }
                    slip => { root.slip(d.deck); }
                    seek(p) => { root.seek(d.deck, p); }
                    hot-cue(s) => { root.hot-cue(d.deck, s); }
                    tempo(v) => { root.tempo(d.deck, v); }
                    stem(s) => { root.stem(d.deck, s); }
                    loop(b) => { root.loop(d.deck, b); }
                    loop-exit => { root.loop-exit(d.deck); }
                    loop-scale(f) => { root.loop-scale(d.deck, f); }
                    beat-jump(b) => { root.beat-jump(d.deck, b); }
                    load => { root.load(d.deck); }
                }
            }
        }
        GlobalBar {
            centre-width: root.show-mixer ? mixer.width : 240px;
            crossfader: root.crossfader;
            master-level: root.master-level;
            headphone-mix: root.headphone-mix;
            headphone-level: root.headphone-level;
            recording: root.recording;
            recording-time: root.recording-time;
            set-crossfader(v) => { root.set-crossfader(v); }
            set-master-level(v) => { root.set-master-level(v); }
            set-headphone-mix(v) => { root.set-headphone-mix(v); }
            set-headphone-level(v) => { root.set-headphone-level(v); }
            toggle-recording => { root.toggle-recording(); }
        }
    }
}
