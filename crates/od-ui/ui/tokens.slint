// Design tokens of the emission-line world.
//
// Colour appears only as emission lines at fixed wavelengths on a charcoal
// continuum (dark) or on paper (light). State is carried by line form (see
// lines.slint), never by hue alone.

import "../fonts/BarlowSemiCondensed-Regular.ttf";
import "../fonts/BarlowSemiCondensed-Medium.ttf";
import "../fonts/BarlowSemiCondensed-SemiBold.ttf";
import { Palette } from "std-widgets.slint";

export global Theme {
    // Accessibility switches, set from settings.
    in-out property <bool> colorblind-safe: false;
    in-out property <bool> high-contrast: false;
    in-out property <bool> motion: true;
    // Phrase types written on the phrase bars (Preferences > View; off:
    // colour blocks only).
    in-out property <bool> phrase-names: true;

    // Appearance (Preferences > View, the sun / moon in the top bar):
    // "dark", "light" or "system". `system` follows the OS through Slint's
    // colour scheme; `os-light` is the app's own probe for platforms where
    // Slint cannot tell (set from Rust).
    in-out property <string> appearance: "dark";
    in-out property <bool> os-light: false;
    out property <bool> system-known: Palette.color-scheme != ColorScheme.unknown;
    // Light mode: paper ground, ink legends, the same wavelengths darkened.
    out property <bool> light: appearance == "light"
        || (appearance == "system" && (Palette.color-scheme == ColorScheme.light || (Palette.color-scheme == ColorScheme.unknown && os-light)));

    // Every colour token: light ? (light values) : (dark values). The
    // contrast test in tests/theme_contrast.rs evaluates this file.

    // Continuum: charcoal in dark, paper in light.
    out property <color> ground: light ? (high-contrast ? #FAF9F5 : #F3F0E8) : (high-contrast ? #0B0B0B : #151514);
    out property <color> ground-band: light ? (high-contrast ? #F2F0E9 : #E9E5DA) : (high-contrast ? #121212 : #1A1A19);
    out property <color> plate: light ? (high-contrast ? #ECE9E0 : #E4E0D4) : (high-contrast ? #1C1C1B : #21211F);
    out property <color> plate-raised: light ? (high-contrast ? #E0DCD0 : #D8D3C5) : #2A2A27;
    out property <color> rule: light ? (high-contrast ? #8A857A : #CAC5B8) : (high-contrast ? #4B4A46 : #33322F);
    out property <color> rule-strong: light ? (high-contrast ? #6A665E : #A39E91) : #4B4A46;

    // Legends: bone on charcoal, ink on paper (all ≥ 4.5:1 on ground and
    // ground-band; see tests/theme_contrast.rs).
    out property <color> bone: light ? (high-contrast ? #000000 : #1D1C1A) : (high-contrast ? #FFFFFF : #E6E0D2);
    out property <color> bone-2: light ? (high-contrast ? #26241F : #4A4740) : (high-contrast ? #E6E0D2 : #B7B1A4);
    out property <color> bone-3: light ? (high-contrast ? #45423C : #5E5A53) : (high-contrast ? #B7B1A4 : #8B867B);

    // Emission lines (nm); darkened on paper to ≥ 3:1 against ground,
    // ground-band and plate.
    out property <color> w405: light ? (colorblind-safe ? #A8467E : #6A4BD8) : (colorblind-safe ? #CC79A7 : #9B7BFF);
    out property <color> w436: light ? #4F56D6 : #7C83FF;
    out property <color> w486: light ? (colorblind-safe ? #0A6EA8 : #1A72A6) : (colorblind-safe ? #56B4E9 : #4FB8F0);
    out property <color> w546: light ? (colorblind-safe ? #007A57 : #2E7A1F) : (colorblind-safe ? #009E73 : #82D16B);
    out property <color> w589: light ? (colorblind-safe ? #776A00 : #856300) : (colorblind-safe ? #F0E442 : #F5CE4A);
    out property <color> w615: light ? (colorblind-safe ? #935D00 : #A54E0E) : (colorblind-safe ? #E69F00 : #F39047);
    out property <color> w656: light ? (colorblind-safe ? #B34E00 : #C23434) : (colorblind-safe ? #D55E00 : #EF5A5A);

    // Semantic lines.
    out property <color> live: w546;
    out property <color> attention: w589;
    out property <color> fault: w656;

    // State changes slide with one damped overshoot.
    out property <easing> spring: cubic-bezier(0.34, 1.4, 0.64, 1);

    // Line weights.
    out property <length> hair: high-contrast ? 2px : 1px;
    out property <length> line: 2px;

    // Type ranks: one family, ranked by size, tracking and ink.
    out property <string> family: "Barlow Semi Condensed";
    out property <length> rank-a: 40px;
    out property <length> rank-b: 24px;
    out property <length> rank-c: 17px;
    out property <length> body: 14px;
    out property <length> index: 11px;
    out property <length> tracking-index: 1.6px;
    out property <length> tracking-c: 2.2px;

    // Spacing (4px grid).
    out property <length> s1: 4px;
    out property <length> s2: 8px;
    out property <length> s3: 12px;
    out property <length> s4: 16px;
    out property <length> s5: 24px;
    out property <length> s6: 32px;

    // The off-centre rail.
    out property <length> rail-x: 28px;
    // Raised to touch size in kiosk mode.
    in-out property <length> row-height: 28px;
    // Touch layout (kiosk, 800 × 480): every key at least 44 px.
    in-out property <bool> touch;
    out property <length> target: root.touch ? 44px : 24px;

    // Deck n (1-based) to its emission line.
    public pure function deck-color(deck: int) -> color {
        if (deck == 1) { return w486; }
        if (deck == 2) { return w615; }
        if (deck == 3) { return w546; }
        return w405;
    }

    // A cue's own colour if it has one, else its slot colour.
    public pure function cue-tone(slot: int, tone: color) -> color {
        if (tone.alpha > 0) { return tone; }
        if (slot < 0) { return bone-3; }
        return cue-color(slot);
    }

    // Hot cue slot (0-based) to a line colour; cues also carry their letter.
    public pure function cue-color(slot: int) -> color {
        if (slot == 0) { return w546; }
        if (slot == 1) { return w486; }
        if (slot == 2) { return w615; }
        if (slot == 3) { return w405; }
        if (slot == 4) { return w589; }
        if (slot == 5) { return w436; }
        if (slot == 6) { return w656; }
        return bone-2;
    }
}
