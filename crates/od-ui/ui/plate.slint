// The selected track as a working plate: readings, overview waveform with
// cue lines, hot cue slots and beatgrid controls.

import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { Caps, PlateButton, Glyph } from "controls.slint";
import { CueMark, HotCueSlot } from "structs.slint";

component Reading inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> tone: Theme.bone;
    spacing: 2px;
    Caps { text: root.label; }
    Text {
        text: root.value == "" ? "—" : root.value;
        font-family: Theme.family; font-size: Theme.rank-b; font-weight: 500;
        color: root.tone;
    }
}

// One letter on the hot cue ruler: a solid line in the cue's colour when
// set, a dashed bone line when empty.
component CueMarkOnRuler inherits Rectangle {
    in property <HotCueSlot> cue;
    callback activate();
    callback remove();
    background: touch.has-hover ? Theme.plate : transparent;
    VLine {
        x: 6px; y: 4px; height: parent.height - 22px;
        tone: root.cue.set ? Theme.cue-color(root.cue.slot) : Theme.bone-3;
        form: root.cue.set ? "solid" : "dashed";
        weight: root.cue.set ? 2px : 1px;
    }
    Text {
        x: 12px; y: 2px;
        text: root.cue.letter;
        font-family: Theme.family; font-size: 14px; font-weight: 600;
        color: root.cue.set ? Theme.bone : Theme.bone-3;
    }
    Text {
        x: 4px; y: parent.height - 16px; width: parent.width - 6px;
        text: root.cue.set ? root.cue.time : "";
        font-family: Theme.family; font-size: 10px;
        color: Theme.bone-3;
        overflow: elide;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.activate(); } }
    if root.cue.set && touch.has-hover: Rectangle {
        x: parent.width - 14px; y: 4px; width: 12px; height: 12px;
        Glyph { x: 2px; y: 2px; width: 8px; height: 8px; kind: "close"; tone: Theme.bone-2; }
        TouchArea { mouse-cursor: pointer; clicked => { root.remove(); } }
    }
}

export component TrackPlate inherits Rectangle {
    in property <bool> has-track;
    in property <string> title;
    in property <string> artist;
    in property <string> bpm;
    in property <string> key;
    in property <string> duration;
    in property <string> grid-source;
    in property <bool> grid-locked;
    in property <image> overview;
    in property <[CueMark]> cues;
    in property <[HotCueSlot]> hot-cues-top;
    in property <[HotCueSlot]> hot-cues-bottom;
    in property <float> cursor: 0;
    in property <bool> previewing;
    in property <bool> analysed;
    callback seek(float);
    callback hot-cue(int);
    callback remove-hot-cue(int);
    callback add-memory-cue();
    callback grid-shift(int);
    callback grid-scale(float);
    callback grid-downbeat();
    callback grid-lock();
    callback analyse();
    callback toggle-preview();

    if !root.has-track: Rectangle {
        Caps { text: @tr("NO TRACK SELECTED"); }
    }
    min-height: root.has-track ? lay.min-height : 40px;
    lay := VerticalLayout {
        visible: root.has-track;
        spacing: Theme.s3;
        Text {
            text: root.title;
            font-family: Theme.family; font-size: Theme.rank-c; font-weight: 600;
            color: Theme.bone; wrap: word-wrap;
        }
        Text {
            text: root.artist;
            font-family: Theme.family; font-size: 14px; color: Theme.bone-2;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: Theme.s5;
            Reading { label: "BPM"; value: root.bpm; }
            Reading { label: @tr("KEY"); value: root.key; }
            Reading { label: @tr("TIME"); value: root.duration; }
        }

        // Overview waveform with cue lines and the cursor.
        Rectangle {
            height: 92px;
            background: Theme.ground-band;
            Image {
                width: parent.width; height: parent.height;
                source: root.overview;
                image-fit: fill;
            }
            for c in root.cues: Rectangle {
                x: parent.width * c.pos;
                width: 1px;
                VLine {
                    x: 0; y: 0; height: parent.height;
                    weight: c.slot >= 0 ? 2px : 1px;
                    tone: c.slot >= 0 ? Theme.cue-color(c.slot) : Theme.bone;
                    form: c.slot >= 0 ? "solid" : "dashed";
                }
                if c.is-loop: Rectangle {
                    x: 0; y: parent.height - 3px; height: 3px;
                    width: (c.end - c.pos) * root.width;
                    background: Theme.cue-color(c.slot).with-alpha(0.6);
                }
                Text {
                    x: 4px; y: 2px;
                    text: c.letter;
                    font-family: Theme.family; font-size: 10px; font-weight: 600;
                    color: Theme.bone;
                }
            }
            // Cursor / preview playhead: doubled sodium.
            VLine {
                x: parent.width * root.cursor - 2px; y: 0; height: parent.height;
                weight: 1px; form: "double"; tone: Theme.attention;
            }
            TouchArea {
                mouse-cursor: crosshair;
                clicked => { root.seek(clamp(self.mouse-x / self.width, 0, 1)); }
                moved => { if (self.pressed) { root.seek(clamp(self.mouse-x / self.width, 0, 1)); } }
            }
        }
        HorizontalLayout {
            spacing: Theme.s2;
            PlateButton {
                compact: true;
                label: root.previewing ? @tr("STOP") : @tr("PREVIEW");
                tone: Theme.attention;
                active: root.previewing;
                clicked => { root.toggle-preview(); }
            }
            PlateButton { compact: true; label: @tr("MEMORY CUE"); tone: Theme.bone; clicked => { root.add-memory-cue(); } }
            if !root.analysed: PlateButton { compact: true; label: @tr("ANALYSE"); tone: Theme.w589; clicked => { root.analyse(); } }
        }

        HorizontalLayout {
            spacing: 8px;
            Caps { text: @tr("HOT CUES"); color: Theme.bone-2; vertical-alignment: center; }
            Text {
                text: @tr("Click an empty letter to set it at the cursor");
                font-family: Theme.family; font-size: 12px; color: Theme.bone-3;
                vertical-alignment: center; overflow: elide;
            }
        }
        // The ruler: A–H as lettered lines.
        Rectangle {
            height: 52px;
            HLine { y: parent.height - 18px; width: parent.width; tone: Theme.rule-strong; }
            HorizontalLayout {
                for c in root.hot-cues-top: CueMarkOnRuler {
                    cue: c;
                    activate => { root.hot-cue(c.slot); }
                    remove => { root.remove-hot-cue(c.slot); }
                }
                for c in root.hot-cues-bottom: CueMarkOnRuler {
                    cue: c;
                    activate => { root.hot-cue(c.slot); }
                    remove => { root.remove-hot-cue(c.slot); }
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.s2;
            Caps { text: @tr("BEATGRID") + "  ·  " + root.grid-source; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.grid-locked: Caps { text: @tr("LOCKED"); color: Theme.attention; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 6px;
            PlateButton { compact: true; label: "−10 MS"; enabled: !root.grid-locked; clicked => { root.grid-shift(-10); } }
            PlateButton { compact: true; label: "+10 MS"; enabled: !root.grid-locked; clicked => { root.grid-shift(10); } }
            PlateButton { compact: true; label: @tr("HALF"); enabled: !root.grid-locked; clicked => { root.grid-scale(0.5); } }
            PlateButton { compact: true; label: @tr("DOUBLE"); enabled: !root.grid-locked; clicked => { root.grid-scale(2.0); } }
        }
        HorizontalLayout {
            spacing: 6px;
            PlateButton { compact: true; label: @tr("DOWNBEAT AT CURSOR"); enabled: !root.grid-locked; clicked => { root.grid-downbeat(); } }
            PlateButton { compact: true; label: root.grid-locked ? @tr("UNLOCK") : @tr("LOCK"); tone: Theme.attention; active: root.grid-locked; clicked => { root.grid-lock(); } }
        }
    }
}
