export struct TreeRow {
    id: int,
    name: string,
    // "folder" | "playlist" | "smart" | "set" | "all" | "recordings"
    kind: string,
    depth: int,
    count: int,
    // Share of the longest list, 0..1, drawn as the length bar.
    length-frac: float,
    duration: string,
    has-children: bool,
    expanded: bool,
    // Assigned to at least one stick.
    on-device: bool,
}

// A folder in the Explorer section of the sidebar.
export struct ExplorerRow {
    id: int,
    name: string,
    path: string,
    depth: int,
    // A user-added root folder (can be removed).
    root: bool,
    has-children: bool,
    expanded: bool,
}

export struct TrackRow {
    id: int,
    // Mini overview waveform for the PREVIEW column.
    preview: image,
    position: int,
    title: string,
    artist: string,
    album: string,
    genre: string,
    bpm: string,
    key: string,
    // Camelot distance to the selected track's key, -1 if unknown.
    key-distance: int,
    time: string,
    rating: int,
    analysed: bool,
    missing: bool,
    selected: bool,
    // Transition note in sets.
    note: string,
    // Deck (1-based) the track is loaded on, 0 if none.
    deck: int,
    // Track colour tag (transparent when none).
    tag-color: color,
}

// A playlist / set the row context menu can add tracks to.
export struct MenuTarget {
    id: int,
    name: string,
}

// One phrase on a phrase bar (positions as fractions of the track).
export struct PhraseMark {
    pos: float,
    end: float,
    label: string,
    tone: color,
}

export struct CueMark {
    // 0..7 for hot cues, -1 for memory cues.
    slot: int,
    letter: string,
    // Position as a fraction of the track.
    pos: float,
    end: float,
    is-loop: bool,
    time: string,
    label: string,
}

export struct HotCueSlot {
    slot: int,
    letter: string,
    set: bool,
    time: string,
    label: string,
}

export struct DeviceRow {
    id: int,
    name: string,
    // "disconnected" | "in-sync" | "pending" | "syncing" | "error"
    state: string,
    detail: string,
    progress: float,
    space: string,
    formats: string,
    connected: bool,
}

export struct VolumeRow {
    index: int,
    name: string,
    space: string,
}

export struct FlowPoint {
    title: string,
    bpm: string,
    key: string,
    energy: float,
    start: string,
    // Fit of the transition into the next track: "good" | "ok" | "clash" | "unknown" | "none"
    tempo-fit: string,
    key-fit: string,
    change: string,
}

// Motion of one zoomed waveform lane. The UI extrapolates the playhead with
// animation-tick() at the display rate and translates the pre-rendered
// tiles, so scrolling is smooth without re-rendering every frame.
export struct LaneMotion {
    loaded: bool,
    // Playhead in seconds when this row was written, and its speed in
    // seconds per millisecond (0 when paused).
    pos: float,
    rate: float,
    // Visible span in seconds.
    span: float,
    // Three consecutive tiles, each `span` seconds wide, and their starts.
    tile0: image,
    tile1: image,
    tile2: image,
    t0: float,
    t1: float,
    t2: float,
}

export struct DeckView {
    deck: int,
    loaded: bool,
    title: string,
    artist: string,
    bpm: string,
    key: string,
    tempo: string,
    elapsed: string,
    remaining: string,
    progress: float,
    playing: bool,
    master: bool,
    sync: bool,
    keylock: bool,
    looping: bool,
    loop-beats: string,
    slip: bool,
    level: float,
    fader: float,
    waveform: image,
    overview: image,
    cues: [CueMark],
    // Hot cue pads A–H, and the two columns A–D / E–H.
    pads: [HotCueSlot],
    pads-left: [HotCueSlot],
    pads-right: [HotCueSlot],
    tempo-value: float,
    tempo-range: string,
    quantize: bool,
    // Stems (part mute): true = muted.
    stems-available: bool,
    stems-busy: bool,
    mute-vocal: bool,
    mute-inst: bool,
    mute-drums: bool,
    mute-bass: bool,
    loop-size: string,
    phrases: [PhraseMark],
    // Current phrase and bars left in it, e.g. "CHORUS · 8".
    phrase: string,
    // Platter rotation in degrees.
    jog-angle: float,
    // Bar.beat counter, e.g. "33.2".
    beat-pos: string,
}

// One mixer channel.
export struct ChannelView {
    channel: int,
    trim: float,
    high: float,
    mid: float,
    low: float,
    cfx: float,
    fader: float,
    cue: bool,
    level: float,
    peak: float,
}

// One Beat FX unit in the FX panel.
export struct FxUnitView {
    // 1 or 2.
    unit: int,
    // Effect: index into the engine's Beat FX list (ECHO … SPIRAL).
    kind: int,
    // Beat length, e.g. "1/2", "3/4", "4".
    beats: string,
    // Channel the unit is inserted on: 0 = master, 1..4 = channel.
    target: int,
    // Depth 0..1 and effect parameter -1..1.
    level: float,
    param: float,
    on: bool,
    // Still sounding after switching off (tail or release).
    ringing: bool,
    // Tempo the unit follows, e.g. "124.0".
    bpm: string,
    // The tempo comes from TAP instead of the decks.
    tapped: bool,
    // Engaged Release FX: -1 none, 0 vinyl brake, 1 backspin, 2 echo out.
    release: int,
}

// One sampler pad of the shown bank.
export struct SamplerPadView {
    // Slot number 0..63 and pad number 1..16 in the bank.
    slot: int,
    pad: int,
    name: string,
    loaded: bool,
    playing: bool,
    // Triggered, waiting for the quantise boundary.
    pending: bool,
    // 0 one-shot, 1 loop, 2 gate.
    mode: int,
    gain: float,
    progress: float,
    selected: bool,
    sync: bool,
}

// The sampler panel's scalar state.
export struct SamplerView {
    bank: int,
    // Selected pad in the shown bank (0..15), -1 if it is in another bank.
    selected: int,
    selected-number: int,
    selected-name: string,
    selected-loaded: bool,
    selected-mode: int,
    selected-gain: float,
    selected-sync: bool,
    selected-bpm: string,
    quantize: bool,
    volume: float,
    cue: bool,
    seq-playing: bool,
    seq-recording: bool,
    // Step the sequencer plays (0..15), -1 when stopped.
    step: int,
}
