// Prepare player, arranged like the export-mode player DJs know: a transport
// column on the left, then the header line, overview with phrase bar, the
// enlarged waveform and a tool bar (CUE/LOOP | GRID tabs), and a cue list on
// the right with MEMORY / HOT CUE / INFO tabs.

import { Theme } from "tokens.slint";
import { VLine, HLine } from "lines.slint";
import { Caps, PlateButton, Toggle, Transport, Splitter, Field } from "controls.slint";
import { Pad, PhraseBar } from "perform.slint";
import { DropZone } from "drag.slint";
import { CueMark, HotCueSlot, PhraseMark } from "structs.slint";

component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> current;
    callback clicked();
    accessible-role: tab;
    accessible-item-selectable: true;
    accessible-item-selected: root.current;
    min-width: t.preferred-width + 24px;
    height: 26px;
    background: root.current ? Theme.plate : touch.has-hover ? Theme.ground-band : transparent;
    border-width: 1px;
    border-color: root.current ? Theme.rule-strong : transparent;
    Rectangle { y: 0; height: 2px; background: root.current ? Theme.attention : transparent; }
    t := Text {
        text: root.label;
        font-family: Theme.family; font-size: 11px; font-weight: 600; letter-spacing: 1.2px;
        color: root.current ? Theme.bone : Theme.bone-3;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Reading inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    // Widest value shown here; keeps the width fixed while digits change.
    in property <string> template;
    // Test / screen-reader identifier of the value (empty: none).
    in property <string> a11y-label;
    spacing: 6px;
    Caps { text: root.label; font-size: 10px; vertical-alignment: center; }
    Text {
        accessible-role: text;
        accessible-label: root.a11y-label;
        accessible-value: self.text;
        min-width: probe.preferred-width;
        horizontal-alignment: right;
        text: root.value == "" ? "—" : root.value; font-family: Theme.family; font-size: 18px; font-weight: 600; color: Theme.bone; vertical-alignment: center;
        probe := Text { visible: false; text: root.template; font-family: Theme.family; font-size: 18px; font-weight: 600; }
    }
}

// Cue editing in the cue list (indices into the player's `cues`).
export global CueEdit {
    in property <[color]> palette;
    callback label(int, string);
    callback color(int, int);
    callback move-to-cursor(int);
    callback to-hot(int);
    callback delete(int);
}

export component PreparePlayer inherits Rectangle {
    in property <bool> has-track;
    in property <string> title;
    in property <string> artist;
    in property <string> bpm;
    in property <string> key;
    in property <string> duration;
    in property <string> position;
    in property <string> grid-source;
    in property <bool> grid-locked;
    in property <bool> analysed;
    in property <bool> read-only;
    in property <image> overview;
    in property <image> detail;
    in property <[CueMark]> cues;
    in property <[PhraseMark]> phrases;
    in property <[HotCueSlot]> hot-cues;
    in property <float> cursor;
    in property <bool> previewing;
    in property <length> info-width: 260px;
    callback seek(float);
    callback nudge(float);
    callback hot-cue(int);
    callback remove-hot-cue(int);
    callback add-memory-cue();
    callback grid-shift(int);
    callback grid-scale(float);
    callback grid-downbeat();
    callback grid-lock();
    // TAP tempo and a typed BPM (Return).
    callback grid-tap();
    callback grid-bpm(string);
    callback analyse();
    callback toggle-preview();
    callback jump-start();
    callback info-dragged(length);
    callback info-reset();
    property <string> tool-tab: "cue";
    property <string> list-tab: "all";
    // Cue list row being edited (index into `cues`), -1 = none.
    property <int> selected-cue: -1;
    background: Theme.ground;
    min-height: 230px;

    HorizontalLayout {
        spacing: 0;

        // Transport column.
        VerticalLayout {
            width: 84px;
            padding: 10px;
            spacing: 10px;
            alignment: center;
            HorizontalLayout {
                spacing: 4px;
                Toggle { accessible-label: "player1.jump-back"; accessible-role: button; horizontal-stretch: 1; label: "−2"; clicked => { root.nudge(-2.0); } }
                Toggle { accessible-label: "player1.jump-forward"; accessible-role: button; horizontal-stretch: 1; label: "+2"; clicked => { root.nudge(2.0); } }
            }
            Caps { text: @tr("SECONDS"); font-size: 10px; horizontal-alignment: center; }
            Rectangle { height: 6px; }
            HorizontalLayout { alignment: center; Transport { accessible-label: "player1.cue"; accessible-role: button; kind: "cue"; tone: Theme.attention; size: 52px; clicked => { root.jump-start(); } } }
            HorizontalLayout { alignment: center; Transport { accessible-label: "player1.play"; accessible-role: button; accessible-checkable: true; accessible-checked: root.previewing; kind: "play"; on: root.previewing; tone: Theme.live; size: 52px; clicked => { root.toggle-preview(); } } }
        }
        VLine { weight: 1px; tone: Theme.rule; }

        // Header, overview, waveform, tool bar.
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0;
            HorizontalLayout {
                height: 34px;
                padding-left: 12px; padding-right: 12px;
                spacing: 18px;
                Text {
                    accessible-role: text;
                    accessible-label: "player1.title";
                    accessible-value: self.text;
                    horizontal-stretch: 2;
                    text: root.has-track ? root.title : @tr("No track selected");
                    font-family: Theme.family; font-size: 16px; font-weight: 600; vertical-alignment: center;
                    color: root.has-track ? Theme.bone : Theme.bone-3; overflow: elide;
                }
                Text { accessible-role: text; accessible-label: "player1.artist"; accessible-value: self.text; horizontal-stretch: 1; text: root.artist; font-family: Theme.family; font-size: 13px; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                Reading { a11y-label: "player1.time-elapsed"; label: @tr("POS"); template: "00:00.000"; value: root.position; }
                Reading { a11y-label: "player1.duration"; label: @tr("TIME"); template: "00:00"; value: root.duration; }
                Reading { a11y-label: "player1.bpm"; label: "BPM"; template: "000.00"; value: root.bpm; }
                Reading { a11y-label: "player1.key"; label: @tr("KEY"); template: "12A"; value: root.key; }
            }
            Rectangle {
                accessible-role: slider;
                accessible-label: "player1.overview";
                height: 40px;
                background: Theme.ground-band;
                Image { width: parent.width; height: parent.height; source: root.overview; image-fit: fill; }
                for c in root.cues: Rectangle {
                    x: parent.width * c.pos;
                    width: 1px;
                    VLine {
                        height: parent.height; weight: c.slot >= 0 ? 2px : 1px;
                        tone: c.slot >= 0 ? Theme.cue-tone(c.slot, c.tone) : Theme.bone;
                        form: c.slot >= 0 ? "solid" : "dashed";
                    }
                    Text { x: 4px; y: 1px; text: c.letter; font-family: Theme.family; font-size: 10px; font-weight: 600; color: Theme.bone; }
                }
                if root.has-track: Rectangle { x: parent.width * root.cursor - 1px; width: 2px; height: parent.height; background: Theme.bone; }
                TouchArea {
                    mouse-cursor: crosshair;
                    clicked => { root.seek(clamp(self.mouse-x / self.width, 0, 1)); }
                    moved => { if (self.pressed) { root.seek(clamp(self.mouse-x / self.width, 0, 1)); } }
                }
            }
            PhraseBar { phrases: root.has-track ? root.phrases : []; }
            HLine { tone: Theme.rule; }
            Rectangle {
                accessible-role: image;
                accessible-label: "player1.enlarged";
                vertical-stretch: 1;
                min-height: 60px;
                background: Theme.ground-band;
                Image { width: parent.width; height: parent.height; source: root.detail; image-fit: fill; }
                Rectangle { x: parent.width / 2 - 1px; width: 2px; height: parent.height; background: Theme.bone; }
                TouchArea {
                    mouse-cursor: ew-resize;
                    // Drag the zoomed waveform to nudge the cursor (8 s across).
                    property <length> last;
                    pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { self.last = self.mouse-x; } }
                    moved => {
                        if (self.pressed) {
                            root.nudge((self.last - self.mouse-x) / self.width * 8.0);
                            self.last = self.mouse-x;
                        }
                    }
                }
                if !root.has-track: Text { text: @tr("Select a track to prepare it"); font-family: Theme.family; font-size: 14px; color: Theme.bone-3; }
            }
            HLine { tone: Theme.rule; }
            // Tool bar.
            HorizontalLayout {
                height: 44px;
                padding-left: 8px; padding-right: 8px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    spacing: 0;
                    Tab { accessible-label: "player1.tab.cue-loop"; label: "CUE / LOOP"; current: root.tool-tab == "cue"; clicked => { root.tool-tab = "cue"; } }
                }
                VerticalLayout {
                    alignment: center;
                    Tab { accessible-label: "player1.tab.grid"; label: @tr("GRID"); current: root.tool-tab == "grid"; clicked => { root.tool-tab = "grid"; } }
                }
                Rectangle { width: 10px; }
                if root.tool-tab == "cue": HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    padding-top: 7px; padding-bottom: 7px;
                    for c in root.hot-cues: Pad {
                        accessible-role: button;
                        accessible-label: "player1.hot-cue." + c.letter;
                        accessible-value: c.set ? (c.label != "" ? c.label : c.time) : "";
                        horizontal-stretch: 1; cue: c; pressed => { root.hot-cue(c.slot); } }
                    Rectangle { width: 8px; }
                    PlateButton { accessible-role: button; accessible-label: "player1.memory.set"; horizontal-stretch: 0; compact: true; height: 30px; label: @tr("MEMORY"); glyph: "plus"; enabled: root.has-track && !root.read-only; clicked => { root.add-memory-cue(); } }
                }
                if root.tool-tab == "grid": HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    padding-top: 9px; padding-bottom: 9px;
                    Field {
                        accessible-role: text-input; accessible-label: "player1.grid.bpm"; accessible-value: self.text;
                        width: 84px; height: 26px;
                        text: root.bpm; placeholder: "BPM";
                        // Follows the track's tempo (also after typing).
                        property <string> track-bpm: root.bpm;
                        changed track-bpm => { self.text = self.track-bpm; }
                        accepted(t) => { root.grid-bpm(t); self.text = root.bpm; }
                    }
                    Toggle { accessible-role: button; accessible-label: "player1.grid.tap"; label: @tr("TAP"); command: "player.grid.tap"; tooltip: @tr("Tap along with the beat: from the fourth tap the grid takes the tapped tempo"); enabled: !root.grid-locked && !root.read-only && root.has-track; clicked => { root.grid-tap(); } }
                    Toggle { accessible-role: button; accessible-label: "player1.grid.shift-left"; label: "−10 MS"; enabled: !root.grid-locked && !root.read-only; clicked => { root.grid-shift(-10); } }
                    Toggle { accessible-role: button; accessible-label: "player1.grid.shift-right"; label: "+10 MS"; enabled: !root.grid-locked && !root.read-only; clicked => { root.grid-shift(10); } }
                    Toggle { accessible-role: button; accessible-label: "player1.grid.halve"; label: @tr("HALF"); enabled: !root.grid-locked && !root.read-only; clicked => { root.grid-scale(0.5); } }
                    Toggle { accessible-role: button; accessible-label: "player1.grid.double"; label: @tr("DOUBLE"); enabled: !root.grid-locked && !root.read-only; clicked => { root.grid-scale(2.0); } }
                    Toggle { accessible-role: button; accessible-label: "player1.grid.downbeat"; label: @tr("DOWNBEAT AT CURSOR"); enabled: !root.grid-locked && !root.read-only; clicked => { root.grid-downbeat(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Caps { accessible-role: text; accessible-label: "player1.grid.source"; accessible-value: self.text; text: root.grid-source; font-size: 10px; vertical-alignment: center; }
                    Toggle { accessible-role: checkbox; accessible-label: "player1.grid.lock"; accessible-checkable: true; accessible-checked: root.grid-locked; label: root.grid-locked ? @tr("GRID LOCKED") : @tr("LOCK GRID"); on: root.grid-locked; tone: Theme.attention; enabled: !root.read-only; clicked => { root.grid-lock(); } }
                }
            }
        }
        VLine { weight: 1px; tone: Theme.rule; }

        // Cue list: MEMORY / HOT CUE / INFO.
        VerticalLayout {
            width: 240px;
            spacing: 0;
            Flickable {
                accessible-role: list;
                accessible-label: "player1.cue-list.rows";
                vertical-stretch: 1;
                VerticalLayout {
                    width: 240px;
                    padding: 8px;
                    spacing: 3px;
                    alignment: start;
                    for c[i] in root.cues: Rectangle {
                        accessible-role: list-item;
                        accessible-label: "player1.cue-list.row\{i}";
                        accessible-value: c.label;
                        property <bool> shown: root.list-tab == "all" ? true : root.list-tab == "memory" ? c.slot < 0 : root.list-tab == "hot" ? c.slot >= 0 : false;
                        visible: self.shown;
                        height: self.shown ? 26px : 0px;
                        background: i == root.selected-cue ? Theme.plate-raised : row.has-hover ? Theme.plate : Theme.ground-band;
                        Rectangle { x: 0; width: 3px; background: Theme.cue-tone(c.slot, c.tone); }
                        Text { x: 10px; text: c.slot >= 0 ? c.letter : (c.is-loop ? "LOOP" : "MEM"); font-family: Theme.family; font-size: 11px; font-weight: 600; color: Theme.bone; vertical-alignment: center; }
                        Text { x: 52px; width: 100px; text: c.label; font-family: Theme.family; font-size: 11px; color: Theme.bone-2; vertical-alignment: center; overflow: elide; }
                        Text { x: parent.width - 64px; width: 58px; text: c.time; font-family: Theme.family; font-size: 11px; color: Theme.bone-2; horizontal-alignment: right; vertical-alignment: center; }
                        row := TouchArea {
                            mouse-cursor: pointer;
                            // Selecting seeks (which rebuilds the rows), so the second
                            // click of a double-click lands on the selected row: that
                            // opens the name field.
                            clicked => {
                                if (root.selected-cue == i) {
                                    name.text = c.label;
                                    name.focus-field();
                                } else {
                                    root.selected-cue = i;
                                    root.seek(c.pos);
                                }
                            }
                        }
                    }
                    if root.list-tab != "info" && root.has-track: Text {
                        visible: root.cues.length == 0 || root.list-tab != "all";
                        text: root.list-tab == "memory" ? @tr("Memory cues appear here. Set one with MEMORY +.") : root.list-tab == "hot" ? @tr("Hot cues appear here. Click an empty pad to set one at the cursor.") : @tr("Cues appear here. Double-click one to name it.");
                        wrap: word-wrap; font-family: Theme.family; font-size: 12px; color: Theme.bone-3;
                    }
                    if root.list-tab == "info": VerticalLayout {
                        spacing: 6px;
                        Reading { label: "BPM"; value: root.bpm; }
                        Reading { label: @tr("KEY"); value: root.key; }
                        Reading { label: @tr("TIME"); value: root.duration; }
                        Reading { label: @tr("GRID"); value: root.grid-source; }
                        if !root.analysed && root.has-track: PlateButton { accessible-role: button; accessible-label: "player1.analyse"; label: @tr("ANALYSE"); tone: Theme.attention; enabled: !root.read-only; clicked => { root.analyse(); } }
                    }
                }
            }
            // Editor of the selected cue: name, colour, move, delete.
            VerticalLayout {
                visible: root.selected-cue >= 0 && root.selected-cue < root.cues.length && root.has-track && !root.read-only;
                height: self.visible ? self.preferred-height : 0px;
                padding: 8px; spacing: 5px;
                name := Field {
                    accessible-label: "player1.cue-list.name"; accessible-role: text-input;
                    placeholder: @tr("Cue name");
                    accepted(t) => { CueEdit.label(root.selected-cue, t); }
                }
                HorizontalLayout {
                    spacing: 3px; height: 20px;
                    for c[ci] in CueEdit.palette: Rectangle {
                        accessible-label: "player1.cue-list.color" + ci; accessible-role: button;
                        background: c; border-width: 1px; border-color: Theme.rule;
                        TouchArea { mouse-cursor: pointer; clicked => { CueEdit.color(root.selected-cue, ci); } }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    PlateButton {
                        accessible-label: "player1.cue-list.move"; accessible-role: button;
                        compact: true; label: @tr("TO CURSOR"); horizontal-stretch: 1;
                        tooltip: @tr("Move the cue to the cursor (snapped to the beat)");
                        clicked => { CueEdit.move-to-cursor(root.selected-cue); }
                    }
                    if root.selected-cue >= 0 && root.selected-cue < root.cues.length && root.cues[root.selected-cue].slot < 0: PlateButton {
                        accessible-label: "player1.cue-list.to-hot"; accessible-role: button;
                        compact: true; label: @tr("→ HOT"); horizontal-stretch: 1;
                        tooltip: @tr("Make this memory cue a hot cue on the first free pad");
                        clicked => { CueEdit.to-hot(root.selected-cue); }
                    }
                    PlateButton {
                        accessible-label: "player1.cue-list.delete"; accessible-role: button;
                        compact: true; glyph: "close"; width: 30px; tone: Theme.fault;
                        tooltip: @tr("Delete this cue");
                        clicked => { CueEdit.delete(root.selected-cue); root.selected-cue = -1; }
                    }
                }
            }
            HLine { tone: Theme.rule; }
            HorizontalLayout {
                padding: 8px;
                spacing: 4px;
                Tab { accessible-label: "player1.cue-list.tab.all"; horizontal-stretch: 1; label: @tr("ALL"); current: root.list-tab == "all"; clicked => { root.list-tab = "all"; } }
                Tab { accessible-label: "player1.cue-list.tab.memory"; horizontal-stretch: 1; label: "MEMORY"; current: root.list-tab == "memory"; clicked => { root.list-tab = "memory"; } }
                Tab { accessible-label: "player1.cue-list.tab.hot-cue"; horizontal-stretch: 1; label: "HOT CUE"; current: root.list-tab == "hot"; clicked => { root.list-tab = "hot"; } }
                Tab { accessible-label: "player1.cue-list.tab.info"; horizontal-stretch: 1; label: "INFO"; current: root.list-tab == "info"; clicked => { root.list-tab = "info"; } }
            }
        }
    }
    DropZone { width: parent.width; height: parent.height; id: -1; }
    HLine { y: parent.height - 1px; width: parent.width; tone: Theme.rule; }
}
