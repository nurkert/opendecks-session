// Track table: no boxes, no fills; bone legends in tabular columns, the
// selected row marked by a rail tick.

import { ListView } from "std-widgets.slint";
import { Theme } from "tokens.slint";
import { DragState, DragTargets, DropZone } from "drag.slint";
import { VLine, HLine } from "lines.slint";
import { Caps, Glyph, TipArea } from "controls.slint";
import { TrackRow, MenuTarget, ColumnView, ColumnChoice, FilterView } from "structs.slint";
import { FilterBar } from "filter.slint";

export global Columns {
    out property <length> pos: 34px;
    out property <length> state: 24px;
}

// A header cell being dragged to a new place (column reorder).
global ColumnDrag {
    in-out property <string> id;
    in-out property <length> x;
    // Index of the cell under the pointer, -1 = none.
    in-out property <int> target: -1;
}

component HeaderCell inherits Rectangle {
    in property <ColumnView> column;
    in property <int> index;
    // Sort by this column: (sort column, ⇧ held).
    callback sort(string, bool);
    // Dropped column `id` on this cell's place.
    callback moved-to(string, int);
    // Right-click: open the column menu at (x, y) in window coordinates.
    callback menu(length, length);
    property <bool> over: ColumnDrag.id != ""
        && ColumnDrag.x >= self.absolute-position.x && ColumnDrag.x < self.absolute-position.x + self.width;
    changed over => {
        if (self.over) {
            ColumnDrag.target = root.index;
        } else if (ColumnDrag.target == root.index) {
            ColumnDrag.target = -1;
        }
    }
    property <bool> right: root.column.right;
    lbl := Caps {
        // The cell itself carries the label; the text is not a second one
        // (column menu items are found by their text).
        accessible-role: none;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: root.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        vertical-alignment: center;
        text: root.column.title;
        overflow: elide;
        color: root.column.rank == 1 ? Theme.bone : root.column.rank > 1 ? Theme.bone-2 : Theme.bone-3;
    }
    if root.column.rank > 0: Glyph {
        x: root.right ? parent.width - lbl.preferred-width - 14px : lbl.preferred-width + 6px;
        y: (parent.height - 8px) / 2;
        width: 8px; height: 8px;
        kind: root.column.descending ? "down" : "up";
        tone: root.column.rank == 1 ? Theme.bone : Theme.bone-3;
    }
    // Secondary sort: its rank next to the arrow.
    if root.column.rank > 1: Text {
        x: root.right ? parent.width - lbl.preferred-width - 24px : lbl.preferred-width + 16px;
        height: parent.height;
        text: root.column.rank;
        font-family: Theme.family; font-size: 9px; color: Theme.bone-3;
        vertical-alignment: center;
    }
    // Where a dragged column lands.
    if root.over && ColumnDrag.id != root.column.id: Rectangle { x: -7px; width: 2px; background: Theme.attention; }
    TipArea {
        tooltip: root.column.sort == "" ? @tr("Drag to move this column")
            : root.column.rank == 1 ? @tr("Sorted by this column — click to reverse, ⇧-click adds a secondary sort, drag to move")
            : @tr("Sort by this column — ⇧-click adds it as a secondary sort, drag to move");
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                if (ColumnDrag.id != "") {
                    if (ColumnDrag.target >= 0) { root.moved-to(ColumnDrag.id, ColumnDrag.target); }
                    ColumnDrag.id = "";
                    ColumnDrag.target = -1;
                } else if (self.has-hover && root.column.sort != "") {
                    root.sort(root.column.sort, ev.modifiers.shift);
                }
            }
        }
        moved => {
            if (self.pressed && (ColumnDrag.id != "" || abs(self.mouse-x - self.pressed-x) > 8px)) {
                ColumnDrag.x = self.absolute-position.x + self.mouse-x;
                ColumnDrag.id = root.column.id;
            }
        }
    }
}

// Text size of the track table (Preferences > View > Browser); the row
// height is `Theme.row-height`.
export global TableStyle {
    in-out property <length> text: 14px;
}

component Cell inherits Text {
    horizontal-alignment: left;
    font-family: Theme.family;
    font-size: TableStyle.text;
    vertical-alignment: center;
    overflow: elide;
}

component TrackLine inherits Rectangle {
    in property <TrackRow> item;
    in property <[ColumnView]> columns;
    in property <bool> show-position;
    // Model index (accessible label `browser.row<index>`).
    in property <int> index;
    // Rows can be dropped between (playlist / set in its own order).
    in property <bool> reorderable;
    callback clicked(bool, bool);
    callback double-clicked();
    // Dropped on a target (DragState.target) after dragging this row.
    callback dropped(int);
    // Rating clicked (1..=5; the current value again clears it).
    callback rate(int);
    // Context menu action, e.g. "deck:2", "color:3", "playlist:17".
    callback menu(string);
    in property <[MenuTarget]> playlists;
    // Lists added to last (inline in the menu) and whether the row is a
    // file of the Explorer (Import instead of library edits).
    in property <[MenuTarget]> recent;
    in property <bool> explorer;
    in property <int> deck-count: 2;
    height: Theme.row-height;
    background: touch.has-hover ? Theme.ground-band : transparent;

    pure function text-of(id: string) -> string {
        return id == "title" ? root.item.title
            : id == "artist" ? root.item.artist
            : id == "album" ? root.item.album
            : id == "genre" ? root.item.genre
            : id == "label" ? root.item.label
            : id == "comment" ? root.item.comment
            : id == "my-tag" ? root.item.my-tag
            : id == "bpm" ? root.item.bpm
            : id == "time" ? root.item.time
            : id == "year" ? root.item.year
            : id == "date-added" ? root.item.date-added
            : id == "plays" ? root.item.plays
            : id == "bitrate" ? root.item.bitrate
            : "";
    }
    property <color> ink: root.item.missing ? Theme.bone-3 : root.item.selected ? Theme.bone : Theme.bone-2;

    // The row's own input first; the cells drawn above keep their clicks
    // (rating) and let the rest through.
    row-menu := ContextMenuArea {
        Menu {
            Menu {
                title: @tr("Load to deck");
                MenuItem { title: @tr("Deck 1"); activated => { root.menu("deck:1"); } }
                MenuItem { title: @tr("Deck 2"); activated => { root.menu("deck:2"); } }
                MenuItem { title: @tr("Deck 3"); activated => { root.menu("deck:3"); } }
                MenuItem { title: @tr("Deck 4"); activated => { root.menu("deck:4"); } }
            }
            MenuItem { title: @tr("Import to collection"); enabled: root.explorer; activated => { root.menu("import"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Analyse"); activated => { root.menu("analyse"); } }
            MenuItem { title: @tr("Lock / unlock analysis"); activated => { root.menu("analysis-lock"); } }
            MenuItem { title: @tr("Separate parts"); activated => { root.menu("stems"); } }
            MenuSeparator { }
            // The lists added to last, one click away; every list in the submenu.
            for p in root.recent: MenuItem { title: @tr("Add to “{}”", p.name); activated => { root.menu("playlist:" + p.id); } }
            Menu {
                title: @tr("Add to playlist");
                for p in root.playlists: MenuItem { title: p.name; activated => { root.menu("playlist:" + p.id); } }
            }
            MenuItem { title: @tr("Add to tag list"); activated => { root.menu("taglist"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Reload tags from file"); enabled: !root.explorer; activated => { root.menu("reload-tags"); } }
            MenuItem { title: @tr("Export file…"); activated => { root.menu("export"); } }
            MenuItem { title: @tr("Reset play count"); enabled: !root.explorer; activated => { root.menu("reset-plays"); } }
            MenuItem { title: @tr("Memory cues to hot cues"); enabled: !root.explorer; activated => { root.menu("memory-to-hot"); } }
            MenuItem { title: @tr("Sort hot cues by time"); enabled: !root.explorer; activated => { root.menu("sort-hot"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Show related tracks"); activated => { root.menu("related"); } }
            Menu {
                title: @tr("Colour");
                MenuItem { title: @tr("Pink"); activated => { root.menu("color:1"); } }
                MenuItem { title: @tr("Red"); activated => { root.menu("color:2"); } }
                MenuItem { title: @tr("Orange"); activated => { root.menu("color:3"); } }
                MenuItem { title: @tr("Yellow"); activated => { root.menu("color:4"); } }
                MenuItem { title: @tr("Green"); activated => { root.menu("color:5"); } }
                MenuItem { title: @tr("Aqua"); activated => { root.menu("color:6"); } }
                MenuItem { title: @tr("Blue"); activated => { root.menu("color:7"); } }
                MenuItem { title: @tr("Purple"); activated => { root.menu("color:8"); } }
                MenuItem { title: @tr("No colour"); activated => { root.menu("color:0"); } }
            }
            Menu {
                title: @tr("Rating");
                MenuItem { title: "★★★★★"; activated => { root.menu("rating:5"); } }
                MenuItem { title: "★★★★"; activated => { root.menu("rating:4"); } }
                MenuItem { title: "★★★"; activated => { root.menu("rating:3"); } }
                MenuItem { title: "★★"; activated => { root.menu("rating:2"); } }
                MenuItem { title: "★"; activated => { root.menu("rating:1"); } }
                MenuItem { title: @tr("No rating"); activated => { root.menu("rating:0"); } }
            }
            MenuSeparator { }
            MenuItem { title: @tr("Remove from this list"); activated => { root.menu("remove"); } }
            MenuItem { title: @tr("Show info"); activated => { root.menu("info"); } }
            MenuItem { title: @tr("Show in file manager"); activated => { root.menu("reveal"); } }
        }
        touch := TouchArea {
            accessible-label: "browser.row\{root.index}";
            accessible-role: list-item;
            accessible-value: root.item.title;
            accessible-item-index: root.index;
            accessible-item-selectable: true;
            accessible-item-selected: root.item.selected;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.clicked(ev.modifiers.control || ev.modifiers.meta, ev.modifiers.shift);
                }
                // The touch area grabs every press, so the enclosing
                // ContextMenuArea never sees a right-click over it: open it here.
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    row-menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
                if (ev.kind == PointerEventKind.up && DragState.active) {
                    if (DragState.target != 0) { root.dropped(DragState.target); }
                    DragState.active = false;
                    DragState.target = 0;
                }
            }
            moved => {
                if (self.pressed && (DragState.active || abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px)) {
                    DragState.label = root.item.title;
                    DragState.x = self.absolute-position.x + self.mouse-x;
                    DragState.y = self.absolute-position.y + self.mouse-y;
                    DragState.kind = "tracks";
                    DragState.active = true;
                }
            }
            double-clicked => { root.double-clicked(); }
        }
    }

    // Selection: one horizontal sodium tick on the rail side.
    if root.item.selected: Rectangle {
        x: 0; y: parent.height / 2 - 1px; width: 12px; height: 2px;
        background: Theme.attention;
    }
    // Loaded on a deck: doubled sodium plus that deck's line and numeral.
    if root.item.deck > 0: Rectangle {
        x: 0; width: 30px; height: parent.height;
        VLine { x: 14px; y: 6px; height: parent.height - 12px; weight: 1px; form: "double"; tone: Theme.attention; }
        VLine { x: 22px; y: 6px; height: parent.height - 12px; weight: 2px; tone: Theme.deck-color(root.item.deck); }
        Text {
            x: 0; height: parent.height; width: 12px;
            text: root.item.deck;
            font-family: Theme.family; font-size: 11px; font-weight: 600;
            color: Theme.deck-color(root.item.deck);
            vertical-alignment: center; horizontal-alignment: center;
        }
    }
    // Colour tag: a short bar on the inner edge of the position column.
    if root.item.tag-color.alpha > 0: Rectangle {
        x: 34px; y: 7px; width: 3px; height: parent.height - 14px;
        background: root.item.tag-color;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 36px;
        spacing: 12px;
        Cell {
            width: Columns.pos;
            text: root.show-position ? root.item.position : "";
            color: Theme.bone-3;
            horizontal-alignment: right;
            font-size: 12px;
        }
        for c in root.columns: Rectangle {
            min-width: c.width > 0 ? c.width : 0px;
            max-width: c.width > 0 ? c.width : 100000px;
            preferred-width: c.width;
            horizontal-stretch: c.width > 0 ? 0 : c.stretch;
            if c.id == "preview": Image { x: 0; y: (parent.height - 20px) / 2; width: parent.width - 6px; height: 20px; source: root.item.preview; image-fit: fill; }
            if c.id == "key": Rectangle {
                Cell { width: parent.width; text: root.item.key; color: root.ink; horizontal-alignment: right; }
                // Harmonic fit to the selected track: solid = same/adjacent, dashed = 2 steps.
                if root.item.key-distance >= 0 && root.item.key-distance <= 2 && !root.item.selected: VLine {
                    x: 2px; y: 8px; height: parent.height - 16px; weight: 1px;
                    tone: Theme.w546;
                    form: root.item.key-distance <= 1 ? "solid" : "dashed";
                }
            }
            if c.id == "colour" && root.item.tag-color.alpha > 0: Rectangle {
                x: 4px; y: (parent.height - 10px) / 2; width: 18px; height: 10px;
                background: root.item.tag-color;
            }
            // Five cells, always clickable to rate; empty ones are faint outlines.
            if c.id == "rating": HorizontalLayout {
                alignment: end;
                spacing: 4px;
                padding-top: 10px; padding-bottom: 10px;
                for i in 5: Rectangle {
                    width: 6px;
                    background: i < root.item.rating ? Theme.bone-2 : transparent;
                    border-width: 1px;
                    border-color: i < root.item.rating ? Theme.bone-2 : Theme.rule;
                    TouchArea {
                        accessible-label: "browser.row\{root.index}.rating\{i + 1}"; accessible-role: button;
                        x: -2px; width: parent.width + 4px; y: -10px; height: parent.height + 20px;
                        mouse-cursor: pointer;
                        clicked => { root.rate(i + 1); }
                    }
                }
            }
            if c.id != "preview" && c.id != "key" && c.id != "colour" && c.id != "rating": Cell {
                x: 0; width: parent.width;
                text: root.text-of(c.id);
                horizontal-alignment: c.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                color: c.id == "title" || c.id == "bpm" ? root.ink : c.id == "artist" && root.item.selected ? Theme.bone-2 : Theme.bone-3;
                font-weight: c.id == "title" && root.item.selected ? 500 : 400;
                font-size: c.id == "title" || c.id == "artist" || c.id == "bpm" ? TableStyle.text : TableStyle.text - 1px;
            }
        }
        // Analysis state: nothing when analysed, half-height pending, struck missing file.
        Rectangle {
            width: Columns.state;
            if root.item.missing || !root.item.analysed: VLine {
                x: parent.width / 2; y: 7px; height: parent.height - 14px; weight: 1px;
                tone: root.item.missing ? Theme.fault : root.item.analysed ? Theme.bone-3 : Theme.attention;
                form: root.item.missing ? "struck" : root.item.analysed ? "solid" : "half";
            }
        }
    }
    // Drop between rows (reorder the open playlist or set).
    DropZone { width: parent.width; height: parent.height; id: DragTargets.row + root.index; enabled: root.reorderable; line: true; }
}

export component TrackTable inherits Rectangle {
    in property <[TrackRow]> rows;
    in property <string> sort-column;
    in property <bool> descending;
    in property <bool> show-position;
    in property <string> empty-text;
    // Row to keep in view after keyboard or controller navigation.
    in property <int> focus-row: -1;
    // Shown columns in order, and every column for the column menu.
    in property <[ColumnView]> columns;
    in property <[ColumnChoice]> column-choices;
    // Rows can be dragged to a new position (playlist / set in its order).
    in property <bool> reorderable;
    // Quick filter bar.
    in property <bool> filter-open;
    in property <FilterView> filter;
    in property <[string]> my-tag-options;
    callback sort(string);
    // ⇧-click: add / reverse a secondary sort column.
    callback sort-then(string);
    callback toggle-column(string);
    callback move-column(string, int);
    callback reset-columns();
    callback toggle-filter();
    callback filter-edit(string, string);
    callback row-clicked(int, bool, bool);
    callback row-activated(int);
    callback row-dropped(int, int);
    callback row-rated(int, int);
    callback row-menu(int, string);
    in property <[MenuTarget]> playlists;
    in property <[MenuTarget]> recent;
    in property <bool> explorer;

    VerticalLayout {
        header := Rectangle {
            accessible-label: "browser.header"; accessible-role: groupbox;
            height: 30px;
            column-menu := ContextMenuArea {
                Menu {
                    for c in root.column-choices: MenuItem {
                        title: c.title;
                        checkable: true;
                        checked: c.visible;
                        activated => { root.toggle-column(c.id); }
                    }
                    MenuSeparator { }
                    MenuItem { title: @tr("Default columns"); activated => { root.reset-columns(); } }
                }
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 36px;
                spacing: 12px;
                HeaderCell {
                    accessible-label: "browser.header.position"; accessible-role: button;
                    width: Columns.pos;
                    column: { id: "position", title: "#", width: Columns.pos, right: true, sort: "position", rank: root.sort-column == "position" ? 1 : 0, descending: root.descending };
                    index: -1;
                    sort(c, shift) => { if (!shift) { root.sort(c); } }
                    menu(x, y) => { column-menu.show({ x: x - header.absolute-position.x, y: y - header.absolute-position.y }); }
                }
                for c[i] in root.columns: HeaderCell {
                    accessible-label: "browser.header.\{c.id}"; accessible-role: button;
                    min-width: c.width > 0 ? c.width : 0px;
                    max-width: c.width > 0 ? c.width : 100000px;
                    preferred-width: c.width;
                    horizontal-stretch: c.width > 0 ? 0 : c.stretch;
                    column: c;
                    index: i;
                    sort(s, shift) => { if (shift) { root.sort-then(s); } else { root.sort(s); } }
                    moved-to(id, to) => { root.move-column(id, to); }
                    menu(x, y) => { column-menu.show({ x: x - header.absolute-position.x, y: y - header.absolute-position.y }); }
                }
                // Attribute column: the analysis / file state of each row.
                Rectangle {
                    accessible-label: "browser.header.attribute"; accessible-role: text;
                    accessible-value: @tr("State");
                    width: Columns.state;
                    VLine { x: parent.width / 2; y: 10px; height: parent.height - 20px; weight: 1px; tone: Theme.bone-3; form: "half"; }
                    TipArea { tooltip: @tr("State column: a short line = waiting for analysis, a struck line = file missing, empty = ready"); }
                }
            }
            // Filter bar toggle (left edge) and the column menu (right edge).
            Rectangle {
                accessible-label: "browser.header.filter"; accessible-role: button;
                accessible-checkable: true; accessible-checked: root.filter-open;
                x: 0; y: 3px; width: 24px; height: 24px;
                background: ft.has-hover ? Theme.plate : transparent;
                Path {
                    x: 6px; y: 7px; width: 12px; height: 10px;
                    viewbox-width: 12; viewbox-height: 10;
                    commands: "M 0 1 L 12 1 M 2 5 L 10 5 M 4.5 9 L 7.5 9";
                    stroke: root.filter.active ? Theme.attention : root.filter-open ? Theme.bone : Theme.bone-3;
                    stroke-width: 1.2px;
                }
                ft := TipArea { tooltip: @tr("Filter the list (BPM, key, rating, My Tag)"); command: "browser.filter"; mouse-cursor: pointer; clicked => { root.toggle-filter(); } }
            }
            Rectangle {
                accessible-label: "browser.header.columns"; accessible-role: button;
                x: parent.width - 30px; y: 3px; width: 24px; height: 24px;
                background: ct.has-hover ? Theme.plate : transparent;
                Path {
                    x: 6px; y: 7px; width: 12px; height: 10px;
                    viewbox-width: 12; viewbox-height: 10;
                    commands: "M 0.5 0 L 0.5 10 M 4.5 0 L 4.5 10 M 8.5 0 L 8.5 10 M 11.5 0 L 11.5 10";
                    stroke: Theme.bone-3;
                    stroke-width: 1px;
                }
                ct := TipArea { tooltip: @tr("Choose the columns (or right-click the header)"); mouse-cursor: pointer; clicked => { column-menu.show({ x: parent.x, y: parent.y + parent.height }); } }
            }
            HLine { y: parent.height - 1px; width: parent.width; tone: Theme.rule; }
        }
        if root.filter-open: FilterBar {
            filter: root.filter;
            my-tags: root.my-tag-options;
            edit(f, v) => { root.filter-edit(f, v); }
        }
        // Empty list: the same `browser.rows` area, showing the hint.
        if root.rows.length == 0: Rectangle {
            accessible-label: "browser.rows"; accessible-role: AccessibleRole.list;
            accessible-value: root.empty-text;
            accessible-item-count: 0;
            vertical-stretch: 1;
            Text {
                text: root.empty-text;
                font-family: Theme.family; font-size: 15px; color: Theme.bone-3;
                wrap: word-wrap;
                horizontal-alignment: center;
                width: min(parent.width - 64px, 460px);
            }
        }
        if root.rows.length > 0: list := ListView {
            accessible-label: "browser.rows"; accessible-role: AccessibleRole.list;
            accessible-item-count: root.rows.length;
            vertical-stretch: 1;
            property <int> target: root.focus-row;
            changed target => { self.reveal(); }
            function reveal() {
                if (root.focus-row < 0) { return; }
                let top = root.focus-row * Theme.row-height;
                if (top < -self.content-y) {
                    self.content-y = -top;
                } else if (top + Theme.row-height > -self.content-y + self.height) {
                    self.content-y = -(top + Theme.row-height - self.height);
                }
            }
            for row[i] in root.rows: TrackLine {
                index: i;
                item: row;
                columns: root.columns;
                reorderable: root.reorderable;
                show-position: root.show-position;
                clicked(ctrl, shift) => { root.row-clicked(i, ctrl, shift); }
                double-clicked => { root.row-activated(i); }
                dropped(t) => { root.row-dropped(i, t); }
                rate(n) => { root.row-rated(i, n == row.rating ? 0 : n); }
                menu(a) => { root.row-menu(i, a); }
                playlists: root.playlists;
                recent: root.recent;
                explorer: root.explorer;
            }
        }
    }
}
